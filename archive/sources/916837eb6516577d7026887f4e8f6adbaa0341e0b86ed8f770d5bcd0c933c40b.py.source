"""Real host pipes only, fixed Python fixture children; no device/network."""
import hashlib,json,os,sys,tempfile,threading,time,unittest
from pathlib import Path
from unittest.mock import patch
import bounded_transport as b
PYTHON=sys.executable
def audit(event,args):
    if event.startswith('socket.') or event in ('os.system','os.exec','os.posix_spawn'):raise AssertionError(event)
    if event=='subprocess.Popen' and (not isinstance(args[1],list) or args[1][:3]!=[PYTHON,'-I','-c']):raise AssertionError('host Python fixture only')
sys.addaudithook(audit)
def child(code):return [PYTHON,'-I','-c',code]
def exact(expected):
    def check(data):b.require(data==expected,'wrong acknowledgement');return data
    return check
class Tests(unittest.TestCase):
    def setUp(self):
        self.tmp=tempfile.TemporaryDirectory();self.root=Path(self.tmp.name).resolve();(self.root/'state').mkdir()
        self.t=b.BoundedTransport(self.root/'evidence',self.root/'state','DEVICE_SERIAL_REDACTED','00000000-0000-4000-8000-000000000001','0123456789abcdef')
    def tearDown(self):self.tmp.cleanup()
    def request(self,code,**kw):return self.t.request('fixture',child(code),output_limit=kw.pop('output_limit',1024),validator=kw.pop('validator',exact(b'OK')),**kw)
    def result(self):return json.loads(next((self.root/'evidence').glob('*/transport-result.json')).read_text())
    def test_binary_and_inflight_before_child(self):
        code=f"import pathlib,sys;assert pathlib.Path({str(self.t.active)!r}).is_file();sys.stdout.buffer.write(b'\\0\\xff\\r\\n')"
        self.assertEqual(self.request(code,validator=exact(b'\0\xff\r\n')),b'\0\xff\r\n');self.assertFalse(self.t.active.exists())
    def test_progressive_four_mib_input(self):
        payload=b'x'*(4<<20);want=hashlib.sha256(payload).hexdigest().encode()
        code='import sys,hashlib;h=hashlib.sha256()\nwhile True:\n d=sys.stdin.buffer.read(4096)\n if not d:break\n h.update(d)\nsys.stdout.buffer.write(h.hexdigest().encode())'
        self.assertEqual(self.request(code,payload=payload,validator=exact(want)),want);self.assertEqual(self.result()['stdin_bytes_sent'],len(payload))
    def test_stdout_flood(self):
        with self.assertRaises(b.Uncertain):self.request("import sys;sys.stdout.buffer.write(b'x'*1000000)",output_limit=100)
        self.assertEqual(next((self.root/'evidence').glob('*/stdout.bin')).stat().st_size,100);self.assertTrue(self.t.active.exists())
    def test_stderr_flood(self):
        with self.assertRaises(b.Uncertain):self.request("import sys;sys.stderr.buffer.write(b'x'*1000000)")
        self.assertEqual(next((self.root/'evidence').glob('*/stderr.bin')).stat().st_size,b.MAX_STDERR)
    def test_timeout_partial_and_reap(self):
        start=time.monotonic()
        with self.assertRaises(b.Uncertain):self.request("import time;print('partial',flush=True);time.sleep(10)",deadline_s=.2)
        self.assertLess(time.monotonic()-start,2);self.assertTrue(self.result()['host_child_reaped']);self.assertFalse(self.result()['remote_completion_proven'])
        self.assertIn(b'partial',next((self.root/'evidence').glob('*/stdout.bin')).read_bytes())
    def test_nonzero(self):
        with self.assertRaises(b.Uncertain):self.request("import sys;sys.stdout.write('OK');sys.exit(7)")
    def test_truncated_ack(self):
        with self.assertRaises(b.Uncertain):self.request("print('O',end='')")
        self.assertFalse(list((self.root/'evidence').glob('*/COMPLETE.json')))
    def test_poison_cross_instance(self):
        with self.assertRaises(b.Uncertain):self.request("print('bad')")
        second=b.BoundedTransport(self.root/'evidence2',self.root/'state',self.t.serial,self.t.boot_id,self.t.txid)
        with patch.object(b.subprocess,'Popen',side_effect=AssertionError('no spawn')):
            for t in (self.t,second):
                with self.assertRaises(b.TransportError):t.request('again',child(''),output_limit=10,validator=exact(b''))
    def test_cancel_event(self):
        self.t.cancel_event=threading.Event();timer=threading.Timer(.1,self.t.cancel_event.set);timer.start()
        try:
            with self.assertRaises(b.Uncertain):self.request('import time;time.sleep(5)')
        finally:timer.join()
        self.assertTrue(self.t.poisoned)
    def test_sigterm(self):
        with self.assertRaises(b.Uncertain):self.request('import os,signal,time;os.kill(os.getppid(),signal.SIGTERM);time.sleep(5)')
        self.assertTrue(self.t.poisoned)
    def test_sigint(self):
        with self.assertRaises(b.Uncertain):self.request('import os,signal,time;os.kill(os.getppid(),signal.SIGINT);time.sleep(5)')
        self.assertTrue(self.t.poisoned)
    def test_failed_readback_never_completes(self):
        def follow(ack,part):
            self.assertTrue(self.t.active.exists());self.assertFalse(list((self.root/'evidence').glob('*/COMPLETE.json')))
            return part('readback',child("print('BAD',end='')"),output_limit=10,validator=exact(b'OK'))
        with self.assertRaises(b.Uncertain):self.request("print('OK',end='')",mutating=True,followup=follow)
        self.assertFalse(list((self.root/'evidence').glob('*/COMPLETE.json')))
    def test_verified_readback_completes(self):
        def follow(ack,part):return part('readback',child("print('OK',end='')"),output_limit=10,validator=exact(b'OK'))
        self.assertEqual(self.request("print('OK',end='')",mutating=True,followup=follow),b'OK')
        self.assertEqual(len(list((self.root/'evidence').glob('*/part-*/PART_VERIFIED.json'))),1)
    def test_partial_host_file_then_lost_ack(self):
        target=self.root/'partial';code=f"import pathlib,sys;pathlib.Path({str(target)!r}).write_bytes(sys.stdin.buffer.read(17))"
        with self.assertRaises(b.Uncertain):self.request(code,payload=b'x'*100,mutating=True,followup=lambda ack,p:ack)
        self.assertEqual(target.read_bytes(),b'x'*17);self.assertTrue(self.t.active.exists())
    def test_total_deadline_applies_to_followup(self):
        def follow(ack,part):return part('late',child('import time;time.sleep(5)'),output_limit=20,validator=exact(b''))
        with self.assertRaises(b.Uncertain):self.request("print('OK',end='')",followup=follow,transaction_deadline=time.monotonic()+.2)
    def test_mutation_requires_followup(self):
        with patch.object(b.subprocess,'Popen',side_effect=AssertionError('no spawn')):
            with self.assertRaises(b.TransportError):self.request('',mutating=True)
        self.assertFalse(self.t.active.exists())
    def test_bounds(self):
        for kw in ({'deadline_s':9},{'output_limit':b.MAX_OUTPUT+1},{'payload':b'x'*(b.MAX_INPUT+1)}):
            with self.subTest(kw=list(kw)):
                with self.assertRaises(b.TransportError):self.request('',**kw)
    def test_crashed_active_blocks(self):
        b.save_json(self.t.active,{'status':'IN_FLIGHT'})
        with patch.object(b.subprocess,'Popen',side_effect=AssertionError('no spawn')):
            with self.assertRaises(b.TransportError):self.request('')
    def test_completed_opid_never_reused(self):
        op='a'*32;self.request("print('OK',end='')",op_id=op)
        with patch.object(b.subprocess,'Popen',side_effect=AssertionError('no spawn')):
            with self.assertRaises(b.TransportError):self.request("print('OK',end='')",op_id=op)
    def test_state_serial_cannot_change(self):
        with self.assertRaises(b.TransportError):b.BoundedTransport(self.root/'other',self.root/'state','OTHER',self.t.boot_id,self.t.txid)
    def test_host_validation_failure_poison_persists(self):
        self.t.mark_uncertain('full hash drift')
        with patch.object(b.subprocess,'Popen',side_effect=AssertionError('no spawn')):
            with self.assertRaises(b.TransportError):self.request('')
    def test_complete_disk_failure_barrier(self):
        real=b.save_json
        def fail(path,value):
            if path.name=='COMPLETE.json':raise OSError('disk failure')
            return real(path,value)
        with patch.object(b,'save_json',side_effect=fail):
            with self.assertRaises(b.Uncertain):self.request("print('OK',end='')")
        self.assertTrue(self.t.active.exists());self.assertTrue(self.t.poisoned)
    def special(self,**kwargs):
        return b.BoundedTransport(self.root/'special',self.root/'state',self.t.serial,self.t.boot_id,self.t.txid,
            recovery_source_sha=b.digest(Path(b.__file__).with_name('uncertainty_recovery.py').read_bytes()),**kwargs)
    def special_request(self,t,**kwargs):
        return t.request(kwargs.pop('label','read'),child("print('OK',end='')"),output_limit=10,validator=exact(b'OK'),**kwargs)
    def context(self):return dict(request_sha256='a'*64,txid=self.t.txid,boot_id=self.t.boot_id)
    def test_reconciliation_preserves_old_global_markers(self):
        for p in (self.t.active,self.t.uncertain):b.save_json(p,{'old':p.name})
        old={p:p.read_bytes() for p in (self.t.active,self.t.uncertain)}
        t=self.special(reconciliation_only=True)
        self.assertEqual(self.special_request(t),b'OK')
        self.assertEqual({p:p.read_bytes() for p in old},old)
        self.assertFalse(t.active.exists());self.assertEqual(len(list(t.completed.iterdir())),1)
        self.assertFalse(list(self.t.completed.iterdir()))
    def test_reconciliation_failure_poison_is_local(self):
        b.save_json(self.t.uncertain,{'old':True});old=self.t.uncertain.read_bytes()
        t=self.special(reconciliation_only=True)
        with self.assertRaises(b.Uncertain):t.request('read',child("print('NO')"),output_limit=10,validator=exact(b'OK'))
        self.assertTrue(t.uncertain.exists());self.assertEqual(self.t.uncertain.read_bytes(),old)
        with patch.object(b.subprocess,'Popen',side_effect=AssertionError('no spawn')):
            with self.assertRaises(b.TransportError):self.special_request(t)
    def test_reconciliation_rejects_mutation_followup_payload(self):
        t=self.special(reconciliation_only=True)
        with patch.object(b.subprocess,'Popen',side_effect=AssertionError('no spawn')):
            for kw in ({'mutating':True,'followup':lambda a,p:a},{'followup':lambda a,p:a},{'payload':b'x'}):
                with self.subTest(kw=list(kw)),self.assertRaises(b.TransportError):self.special_request(t,**kw)
    def test_pending_blocks_all_modes(self):
        b.save_json(self.t.state/'RECOVERY_PENDING.json',{})
        t=self.special(reconciliation_only=True)
        with patch.object(b.subprocess,'Popen',side_effect=AssertionError('no spawn')):
            for transport in (self.t,t):
                with self.assertRaises(b.TransportError):self.special_request(transport)
    def test_recovery_only_blocks_normal_mode(self):
        b.save_json(self.t.state/'RECOVERY_ONLY.json',{})
        with patch.object(b.subprocess,'Popen',side_effect=AssertionError('no spawn')):
            with self.assertRaises(b.TransportError):self.request('')
    def test_recovery_context_mutation_allowlist_and_each_part_gate(self):
        t=self.special(recovery_context=self.context())
        with patch.object(t,'_validate_recovery_context',return_value={}) as check:
            with patch.object(b.subprocess,'Popen',side_effect=AssertionError('no spawn')):
                with self.assertRaises(b.TransportError):self.special_request(t,label='create-stage',mutating=True,followup=lambda a,p:a)
            def follow(ack,part):return part('readback',child("print('OK',end='')"),output_limit=10,validator=exact(b'OK'))
            self.assertEqual(self.special_request(t,label='write-boot_b',mutating=True,followup=follow),b'OK')
            self.assertEqual(self.special_request(t,label='write-misc32',mutating=True,followup=follow),b'OK')
            self.assertGreaterEqual(check.call_count,8)
    def test_recovery_context_validator_refusal_prevents_spawn(self):
        t=self.special(recovery_context=self.context())
        with patch.object(t,'_validate_recovery_context',side_effect=b.TransportError('expired')),patch.object(b.subprocess,'Popen',side_effect=AssertionError('no spawn')):
            with self.assertRaises(b.TransportError):self.special_request(t)
    def test_recovery_pin_and_context_fail_closed(self):
        with self.assertRaises(b.TransportError):b.BoundedTransport(self.root/'bad',self.root/'state',self.t.serial,self.t.boot_id,self.t.txid,reconciliation_only=True,recovery_source_sha='0'*64)
        with self.assertRaises(b.TransportError):self.special(recovery_context={**self.context(),'boot_id':'bad'})
        t=self.special(reconciliation_only=True);t.recovery_source_sha='0'*64
        with patch.object(b.subprocess,'Popen',side_effect=AssertionError('no spawn')):
            with self.assertRaises(b.TransportError):self.special_request(t)
if __name__=='__main__':unittest.main(verbosity=2)
