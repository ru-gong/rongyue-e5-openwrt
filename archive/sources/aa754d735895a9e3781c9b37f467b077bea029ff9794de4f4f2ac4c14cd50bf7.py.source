    self.receipt(out,count,'read-'+part,e.read_script(part,0,len(raw),op,NEW,p),data,len(raw)+1024)
  result={'schema':'e5-next-readonly-v1','serial':c.SERIAL,'boot_id':NEW,'txid':TX,'purpose':self.purpose,'reconciliation':c.binding(rp),'cold_envelope':e.binding_without_originals(envelope),'state_snapshot':self.statebind,'helper_owner_tx':TX,'producer_source_sha256':c.sha(c.read(Path(r.__file__))),'source_pins':c.PINS,'transport_binding':c.binding(tp),'device_writes':False,'native_helpers_executed':False,'approved_to_restore':False};resultpath=out/'READONLY_RESULT.json';resultpath.write_bytes(c.canonical(result)+b'\n');rb=c.binding(resultpath)
