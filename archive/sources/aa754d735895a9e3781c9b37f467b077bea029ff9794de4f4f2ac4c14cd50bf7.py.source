  self.statebind=self.write('state.json',self.state);self.simconfirm=self.write('sim-confirmation.json',{'schema':'e5-sim-placement-confirmation-v2','serial':c.SERIAL,'slot1':'China Mobile','slot2':'China Unicom','user_confirmed':True})
  for p in (patch.object(c,'dependencies',return_value={}),patch.object(c,'ROOT',self.root),patch.object(c,'now',return_value=self.clock),patch.object(c,'state_snapshot',side_effect=lambda:copy.deepcopy(self.state))):p.start();self.addCleanup(p.stop)
