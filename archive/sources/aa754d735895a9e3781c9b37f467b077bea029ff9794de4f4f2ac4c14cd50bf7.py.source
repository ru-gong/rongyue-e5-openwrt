 def engine_fixture(self,fail=None):
  sp=importlib.util.spec_from_file_location('_e5_engine_fixture',c.LIVE/'bounded_boot_control.py');b=importlib.util.module_from_spec(sp);sp.loader.exec_module(b)
  before=bytearray(64<<20);misc=bytearray(c.read(c.ORIGINAL_MISC));profile=b.profile();events=[];calls=[];poison=[];out=self.root/'evidence/engine';out.mkdir()
  class FakeLedger:
   rows=[];head='0'*64
   def __enter__(self):return self
   def __exit__(self,*a):pass
   def poisoned(self):return False
   def event(self,event,**fields):events.append((event,fields));self.rows.append({'event':event,**fields})
  class Fake:
   p=profile;boot_id=NEW;txid=TX
   def preflight(self,budget):
    calls.append(('protect',));c.require(fail!='protect','protection changed')
   def read_chunk(self,part,off,n,budget):
    calls.append(('read',part,off,n));raw=bytes(before if part=='boot_b' else misc)
    if fail=='b-after' and events and any(ev=='VERIFIED' for ev,_ in events) and part=='boot_b':raw=b'X'+raw[1:]
    return raw[off:off+n]
   def write_chunk(self,part,off,data,op,budget):
    calls.append(('write',part,off,len(data)));c.require(fail!='write','lost ack');misc[off:off+len(data)]=data
    if fail=='outside':misc[0]^=1
    return {'op_id':op,'part':part,'offset':off,'bytes':len(data),'fsync_completed':True}
   def poison(self,reason):poison.append(reason)
  request={'helper_owner_tx':TX,'request_id':'a'*32,'boot_id':NEW,'ledger_head':'0'*64,'total_seconds':100,'expected_before':{'boot_b':c.sha(bytes(before)),'misc':c.sha(bytes(misc))},'nv_source_gate':{'hashes':{}},'target_bc32_hex':b.trial_bc(bytes(misc)[2048:2080]).hex(),'expires_at':(self.clock+dt.timedelta(seconds=200)).isoformat()}
  patches=[patch.object(arm.nv,'check_live',return_value=None),patch.object(b,'Ledger',FakeLedger),patch.object(b,'_protected',side_effect=lambda n,p,budget,ledger=None:n.preflight(budget)),patch.object(arm,'same_candidate',return_value=None)]
  for p in patches:p.start();self.addCleanup(p.stop)
  return Fake(),b,request,out,events,calls,poison
 def test_rearm_engine_only32_no_B_write(self):
  native,b,rq,out,events,calls,poison=self.engine_fixture();result=arm._engine(native,b,rq,'a'*64,out,None)
  self.assertEqual([x for x in calls if x[0]=='write'],[('write','misc',2048,32)]);self.assertEqual(events[-1][0],'COMPLETE');self.assertFalse(result['boot_b_written']);self.assertFalse(poison)
 def test_rearm_faults_stop_poison_and_no_retry(self):
  for mode in ('protect','write','outside','b-after'):
   with self.subTest(mode=mode):
    # Independent temporary fixture/ledger for each failure, no device backend.
    out=self.root/'evidence/engine'
    if out.exists():
     import shutil;shutil.rmtree(out)
    native,b,rq,dest,events,calls,poison=self.engine_fixture(mode)
    with self.assertRaises(RuntimeError):arm._engine(native,b,rq,'a'*64,dest,None)
    self.assertEqual(events[-1][0],'UNKNOWN');self.assertTrue(poison);self.assertLessEqual(len([x for x in calls if x[0]=='write']),1)
 def test_rearm_cancel_before_write(self):
  import threading
  native,b,rq,out,events,calls,poison=self.engine_fixture();cancel=threading.Event();cancel.set()
  with self.assertRaises(RuntimeError):arm._engine(native,b,rq,'a'*64,out,cancel)
  self.assertFalse([x for x in calls if x[0]=='write'])
 def refresh_fixture(self):
  env,folder=self.cold_fixture();prior=c.obj(env);later=self.clock+dt.timedelta(seconds=2000);self.clock=later
  req=self.write('refresh-request.json',{'schema':'e5-next-refresh-request-v1','serial':c.SERIAL,'boot_id':NEW,'state_snapshot':self.statebind,'prior_envelope':env,'purpose':self.purpose,'sim_confirmation':None});dest=self.root/'evidence/refresh';dest.mkdir()
  import shutil
  for file in folder.iterdir():
   if 'health-' in file.name:
    match=re.search(r'health-(\d+)',file.name)
    if match and int(match.group(1))>1:continue
   shutil.copyfile(file,dest/file.name)
  sb=json.loads((dest/'SOURCE_BINDING.json').read_text());sb.update(old_boot_id=NEW,request=req);(dest/'SOURCE_BINDING.json').write_bytes(c.canonical(sb)+b'\n')
  for i in range(2):
   at=later-dt.timedelta(seconds=10-i*2.1);rawfile=next(dest.glob(f'*-health-{i:02d}.stdout'));raw=rawfile.read_bytes();raw=raw.replace(f'{30+i*30.1:.2f} 40.00'.encode(),f'{2030+i*2.1:.2f} 40.00'.encode());rawfile.write_bytes(raw)
   stem=rawfile.name[:-7]
   for suffix in ('.request.json','.result.json'):
    p=dest/(stem+suffix);v=json.loads(p.read_text());v['started_at']=at.isoformat()
    if suffix=='.result.json':v['finished_at']=(at+dt.timedelta(seconds=.01)).isoformat();v['stdout_sha256']=c.sha(raw);v['stdout_bytes']=len(raw)
    p.write_bytes(c.canonical(v)+b'\n')
   capture,triage=o.load_sources();(dest/f'health-{i:02d}.parsed.json').write_bytes(c.canonical({'captured_at':at.isoformat(),'snapshot':o.parse_health(raw,triage,NEW,self.purpose)})+b'\n')
  sequence=('pstore-console','pstore-dmesg','crash','pid1-stat-before','pid1-namespace-before','pid1-mountinfo','pid1-namespace-after','pid1-stat-after')
  for phase,offset in (('initial',0),('final',2.1)):
   for index,label in enumerate(sequence):
    at=later-dt.timedelta(seconds=10-offset)+dt.timedelta(seconds=.1+index*.1)
    for suffix in ('.request.json','.result.json'):
     p=next(dest.glob('*-'+phase+'-'+label+suffix));v=json.loads(p.read_text());v['started_at']=at.isoformat()
     if suffix=='.result.json':v['finished_at']=(at+dt.timedelta(seconds=.01)).isoformat()
     p.write_bytes(c.canonical(v)+b'\n')
    if label.startswith('pid1-'):
     p=dest/(phase+'-pid1-diagnostic.json');v=json.loads(p.read_text());v['raw'][label[5:]]['started_at']=at.isoformat();p.write_bytes(c.canonical(v)+b'\n')
  complete=json.loads((dest/'COMPLETE.json').read_text());complete.update(schema='e5-next-sameboot-refresh-v1',old_boot_id=NEW,samples=2,span_seconds=2.1,request=req,new_cold_observation=False,historical_cold_envelope=env);(dest/'COMPLETE.json').write_bytes(c.canonical(complete)+b'\n');cb=c.binding(dest/'COMPLETE.json')
  with patch.object(c,'now',return_value=later):_,digest,_=e.cold_evidence(cb,later,refresh=True)
  review=self.write('refresh-review.json',{'schema':'e5-next-refresh-independent-review-v1','serial':c.SERIAL,'boot_id':NEW,'complete':cb,'raw_evidence_sha256':digest,'state_snapshot':self.statebind,'purpose':self.purpose,'decision':'SAME_BOOT_READONLY_REFRESH','current_ui_confirmed':True,'initial_final_logs_and_health_reviewed':True,'new_panic_or_unassessed_abnormality':False,'device_writes_allowed':False,'collector':'a','reviewer':'b','captured_at':later.isoformat(),'expires_at':(later+dt.timedelta(seconds=800)).isoformat()})
  pair=self.write('refresh-pair.json',{'schema':'e5-next-refresh-review-pair-v1','complete':cb,'review':review});new={**prior,'cold_refresh':pair};return self.write('refreshed-envelope.json',new),later
