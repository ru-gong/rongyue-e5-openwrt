  envelope.update(readonly_result=rb,original_review=review);env=self.write('envelope.json',envelope);return env,rb,out
 def receipt(self,out,index,label,script,raw,limit):
  op=uuid.uuid4().hex;folder=out/'transport'/f'{index:06d}-{label}-{op}';folder.mkdir();argv=e.argv(e.base(NEW,self.purpose,TX)+script)
  complete={'schema':'e5-bounded-transport-v1','serial':c.SERIAL,'boot_id':NEW,'txid':TX,'op_id':op,'status':'COMPLETE','validated':True,'mutating':False,'reconciliation_only':True,'recovery_context':None,'payload_bytes':0,'payload_sha256':c.sha(b''),'deadline_seconds':8,'automatic_retry':False,'evidence_directory':str(folder),'stdout_sha256':c.sha(raw),'argv':argv,'argv_sha256':c.sha(c.canonical(argv)),'label':label,'output_limit':limit}
  flight={k:v for k,v in complete.items() if k not in ('validated','stdout_sha256')};flight['status']='IN_FLIGHT'
  meta={'failure':None,'returncode':0,'elapsed_seconds':.1,'host_child_reaped':True,'stdin_bytes_sent':0,'stdout_bytes':len(raw),'stdout_sha256':c.sha(raw),'stderr_bytes':0}
  for name,value in [('stdout.bin',raw),('stderr.bin',b''),('COMPLETE.json',complete),('IN_FLIGHT.json',flight),('transport-result.json',meta)]:
   (folder/name).write_bytes(value if isinstance(value,bytes) else c.canonical(value)+b'\n')
