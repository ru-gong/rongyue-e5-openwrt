"""Fake-only tests. Deny process/socket before importing the library."""
import sys

def deny(event,args):
    if event.startswith(('subprocess.','socket.')) or event in ('os.system','os.exec','os.posix_spawn'):raise AssertionError('external operation forbidden')
sys.addaudithook(deny)
import copy,json,tempfile,unittest
from pathlib import Path
from types import SimpleNamespace
from unittest.mock import patch
import bounded_provision as p
TX='0123456789abcdef';BOOT='00000000-0000-4000-8000-000000000001'
def meta(i,kind='d',size=4096,mode='700'):
    return dict(mode_bits=(0o40000 if kind=='d' else 0o100000)|int(mode,8),dev=9,inode=i,bytes=size,mode=mode,uid=0,gid=0,nlink=1,mtime='1',ctime='2',mtime_text='1.000000001',ctime_text='2.000000002',rdev_major=0,rdev_minor=0,type=kind)
def snapshot(locked):
    s={k:meta(i) for k,i in [('data',1),('local',2),('tmp',3)]}
    if locked:s.update(lock=meta(4),owner=meta(5,'f',17,'600'),owner_sha256=p.sha((TX+'\n').encode()))
    return s
def statline(r):return '|'.join([format(r['mode_bits'],'x'),str(r['dev']),str(r['inode']),str(r['bytes']),r['mode'],str(r['uid']),str(r['gid']),str(r['nlink']),r['mtime'],r['ctime'],r['mtime_text'],r['ctime_text'],'0','0'])
class Artifact:
    def __init__(self,path):self.path=path;self.size=path.stat().st_size;self.sha256=p.sha(path.read_bytes())
    def verify(self):
        if self.path.stat().st_size!=self.size or p.sha(self.path.read_bytes())!=self.sha256:raise p.Refusal('artifact changed')
class Fake:
    def __init__(self,root):
        self.txid=TX;self.boot_id=BOOT;self.lock=p.LOCK;self.events=[];self.scripts=[];self.active=False;self.fail=None;self.ack=b'';self.hash_fail=None;self.complete_fail=False
        self.transport=SimpleNamespace(evidence=root,poisoned=False,recovery_context=None,reconciliation_only=False,mark_uncertain=self.poison)
        for a in ('scanner','io_helper','helper'):
            f=root/(a+'.bin');f.write_bytes((a+'\0\xff').encode());setattr(self,a,Artifact(f))
    def poison(self,reason):self.transport.poisoned=True;self.events.append('UNKNOWN')
    def _locked(self):return 'test owner\n'
    def _deadline(self):return 6000
    def _hash(self,path,size):
        a=next(a for a,stem,_,_,_ in p.HELPERS if path.endswith('e5-clean-'+stem+'.'+TX));self.events.append('hash-'+a+('-ACTIVE' if self.active else ''))
        if self.hash_fail==a:raise p.Refusal('bad independent SHA')
        return getattr(self,a).sha256,meta(10+list(a for a,_,_,_,_ in p.HELPERS).index(a),'f',size)
    def _request(self,label,script,**kw):
        self.events.append(label);self.scripts.append((label,script,kw));self.active=True
        try:
            if label==self.fail:raise TimeoutError('timeout/lost ACK')
            result=kw['followup'](kw['validator'](self.ack))
            if self.complete_fail and label=='bounded-provision-helper':raise OSError('COMPLETE fsync failure')
            self.events.append(label+':COMPLETE');self.active=False;return result
        except BaseException:self.poison('request');raise
class Tests(unittest.TestCase):
    def setUp(self):
        self.tmp=tempfile.TemporaryDirectory();self.addCleanup(self.tmp.cleanup);self.root=Path(self.tmp.name).resolve();self.a=Fake(self.root);self.w=p.BoundedProvision(self.a)
        self.helpers=tuple((a,stem,name,getattr(self.a,a).size,getattr(self.a,a).sha256) for a,stem,name,_,_ in p.HELPERS)
    def run_fake(self,states=None):
        def snap(**kw):self.a.events.append('snapshot'+('-ACTIVE' if self.a.active else ''));return snapshot(kw['locked'])
        with patch.object(p,'PROVISION_IO_DISABLED',False),patch.object(p,'HELPERS',self.helpers),patch.object(self.w,'_contract',return_value=self.a.transport),patch.object(self.w,'_snapshot',side_effect=states or snap):return self.w.run()
    def test_disabled_before_contract(self):
        with patch.object(self.w,'_contract',side_effect=AssertionError('no transport')),self.assertRaisesRegex(p.Refusal,'PROVISION_IO_DISABLED'):self.w.run()
        self.assertEqual(self.a.events,[])
    def test_contract_rejects_fake_before_io(self):
        with self.assertRaisesRegex(p.Refusal,'exact live adapter'):self.w._contract()
    def test_success_fixed_order_same_active(self):
        r=self.run_fake();self.assertEqual([x[0] for x in self.a.scripts],['bounded-provision-lock','bounded-provision-scanner','bounded-provision-io_helper','bounded-provision-helper'])
        self.assertEqual(len(r['operations']),4);self.assertFalse(r['approved_to_activate']);self.assertFalse(r['native_helpers_executed']);self.assertEqual(set(r['helpers']),{'scanner','io_helper','helper'})
        self.assertTrue(all(x.endswith('-ACTIVE') for x in self.a.events if x.startswith('hash-')));self.assertEqual(sum(x.endswith(':COMPLETE') for x in self.a.events),4);self.assertFalse(self.a.transport.poisoned)
        self.assertEqual((self.root/'BOUNDED_PROVISION_RESULT.json').stat().st_mode&0o777,0o600)
    def test_existing_result_refused_before_device(self):
        (self.root/'BOUNDED_PROVISION_RESULT.json').write_text('{}')
        with self.assertRaisesRegex(p.Refusal,'existing result'):self.run_fake()
        self.assertEqual(self.a.scripts,[])
    def test_no_wrapper_replay(self):
        self.run_fake();count=len(self.a.scripts)
        with patch.object(p,'PROVISION_IO_DISABLED',False),self.assertRaisesRegex(p.Refusal,'no replay'):self.w.run()
        self.assertEqual(count,len(self.a.scripts))
    def test_recovery_modes_refused(self):
        for field,val in [('recovery_context',{}),('reconciliation_only',True)]:
            self.w.used=False;setattr(self.a.transport,field,val)
            with self.assertRaisesRegex(p.Refusal,'normal-only'):self.run_fake()
            setattr(self.a.transport,field,None if field=='recovery_context' else False)
        self.assertEqual(self.a.scripts,[])
    def test_existing_lock_or_helper_stops(self):
        with self.assertRaisesRegex(p.Refusal,'exists'):self.run_fake(states=lambda **kw:(_ for _ in ()).throw(p.Refusal('exists')))
        self.assertEqual(self.a.scripts,[]);self.assertTrue(self.a.transport.poisoned)
    def test_all_material_precheck_before_lock(self):
        self.a.helper.path.write_bytes(b'changed')
        with self.assertRaisesRegex(p.Refusal,'artifact changed'):self.run_fake()
        self.assertEqual(self.a.scripts,[])
    def test_timeout_each_step_no_later_mutation(self):
        labels=['bounded-provision-lock','bounded-provision-scanner','bounded-provision-io_helper','bounded-provision-helper']
        for i,label in enumerate(labels):
            self.w.used=False;self.a.events=[];self.a.scripts=[];self.a.fail=label
            with self.assertRaises(TimeoutError):self.run_fake()
            self.assertEqual([x[0] for x in self.a.scripts],labels[:i+1]);self.assertTrue(self.a.transport.poisoned);self.assertFalse((self.root/'BOUNDED_PROVISION_RESULT.json').exists())
    def test_hash_failure_no_later_helpers(self):
        self.a.hash_fail='scanner'
        with self.assertRaisesRegex(p.Refusal,'independent SHA'):self.run_fake()
        self.assertEqual(len(self.a.scripts),2);self.assertNotIn('bounded-provision-scanner:COMPLETE',self.a.events)
    def test_owner_drift_after_upload(self):
        calls=0
        def states(**kw):
            nonlocal calls;calls+=1;s=snapshot(kw['locked'])
            if calls==4:s['owner']['ctime']='changed'
            return s
        with self.assertRaisesRegex(p.Refusal,'owner changed'):self.run_fake(states=states)
        self.assertEqual(len(self.a.scripts),2)
    def test_parent_inode_drift(self):
        for key in ('data','local','tmp','lock'):
            a=snapshot(True);b=copy.deepcopy(a);b[key]['inode']+=1
            with self.assertRaises(p.Refusal):p.same_snapshot(a,b)
    def test_parent_uid_drift_refused(self):
        before=snapshot(True);after=copy.deepcopy(before);after['tmp']['uid']=2000
        with self.assertRaises(p.Refusal):p.same_snapshot(before,after)
    def test_failure_text_ack_rejected(self):
        self.a.ack=b'failure'
        with self.assertRaisesRegex(p.Refusal,'unexpected bootstrap output'):self.run_fake()
        self.assertEqual(len(self.a.scripts),1)
    def test_interrupt_poison(self):
        with patch.object(self.a,'_request',side_effect=KeyboardInterrupt),self.assertRaises(KeyboardInterrupt):self.run_fake()
        self.assertTrue(self.a.transport.poisoned)
    def test_result_fsync_failure(self):
        with patch.object(p,'durable_result',side_effect=OSError('disk full')),self.assertRaises(OSError):self.run_fake()
        self.assertNotIn('bounded-provision-helper:COMPLETE',self.a.events)
    def test_result_alone_not_complete(self):
        self.a.complete_fail=True
        with self.assertRaises(OSError):self.run_fake()
        self.assertTrue((self.root/'BOUNDED_PROVISION_RESULT.json').exists());self.assertTrue(self.a.transport.poisoned);self.assertNotIn('bounded-provision-helper:COMPLETE',self.a.events)
    def test_scripts_timeout_noclobber_and_eof_deadline(self):
        self.run_fake()
        for label,script,kw in self.a.scripts:
            self.assertIn('timeout -s TERM 6',script);self.assertIn('set -C',script);self.assertIn('/proc/uptime',script);self.assertTrue(kw['mutating']);self.assertTrue(callable(kw['followup']))
            if label!='bounded-provision-lock':
                self.assertLess(script.index('cat >'),script.index('chmod 700'));self.assertGreater(script.count('/proc/uptime'),2);self.assertIn('/proc/uptime',script[script.index('cat >'):script.index('chmod 700')]);self.assertNotIn('rm ',script)
    def test_snapshot_actual_parser(self):
        def answer(label,script,**kw):
            locked='printf \'OWNER' in script;s=snapshot(locked);op=kw['op_id'];keys=['data','local','tmp']+(['lock','owner'] if locked else [])
            lines=[f'STATE\t{op}\t{BOOT}']+[k+'\t'+statline(s[k]) for k in keys]
            if locked:lines+=['OWNER\t'+s['owner_sha256']+'  '+p.LOCK+'/owner']
            else:self.assertIn('test ! -e '+p.LOCK,script)
            for path in self.w.remote.values():self.assertIn('test ! -e '+path,script)
            lines+=[f'END\t{op}\t{BOOT}'];return kw['validator'](('\n'.join(lines)+'\n').encode())
        with patch.object(self.a,'_request',side_effect=answer):
            for locked in (False,True):self.assertEqual(self.w._snapshot(locked=locked,all_absent=True),snapshot(locked))
    def test_parent_shell_uid_allowed_without_changing_lock_contract(self):
        def answer(label,script,**kw):
            s=snapshot(True);s['local']['uid']=2000;s['tmp']['uid']=2000;s['tmp']['gid']=2000;op=kw['op_id']
            lines=[f'STATE\t{op}\t{BOOT}']+[k+'\t'+statline(s[k]) for k in ('data','local','tmp','lock','owner')]
            lines+=['OWNER\t'+s['owner_sha256']+'  '+p.LOCK+'/owner',f'END\t{op}\t{BOOT}']
            return kw['validator'](('\n'.join(lines)+'\n').encode())
        with patch.object(self.a,'_request',side_effect=answer):
            got=self.w._snapshot(locked=True);self.assertEqual(got['tmp']['uid'],2000);self.assertEqual(got['lock']['uid'],0)
    def test_helper_metadata_rejects_wrong_file(self):
        for change in ({'mode':'600'},{'nlink':2},{'dev':10},{'type':'d'}):
            bad=meta(10,'f',self.a.scanner.size);bad.update(change)
            with patch.object(self.a,'_hash',return_value=(self.a.scanner.sha256,bad)),self.assertRaises(p.Refusal):self.w._verify_helper('scanner',snapshot(True))
if __name__=='__main__':unittest.main(verbosity=2)
