#!/usr/bin/env python3
"""Host-only source/byte tests, all external process/network execution denied."""
import ast
import contextlib
import importlib.util
import io
import json
from pathlib import Path
import struct
import sys
import unittest
from unittest import mock
import zlib

HERE=Path(__file__).resolve().parent;WORK=HERE.parents[1]
spec=importlib.util.spec_from_file_location("collect",HERE/"collect.py")
c=importlib.util.module_from_spec(spec);spec.loader.exec_module(c)


class Tests(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        cls.misc=(WORK/"evidence/preflight-20261013/recovery-backup-04/misc.full.raw.bin").read_bytes()
    def test_contract_exact_and_physical_map(self):
        self.assertEqual(c.CONTRACT,json.loads((HERE/"contract.json").read_text()))
        self.assertEqual(len(c.CONTRACT["protected_hashes"]),13)
        self.assertEqual(len(c.CONTRACT["nv_partitions"]),9)
        self.assertEqual(c.CONTRACT["partitions"]["boot_a"]["partition_number"],36)
        self.assertEqual(c.CONTRACT["partitions"]["boot_b"]["partition_number"],37)
    def test_misc_original_matches(self):
        self.assertTrue(c.analyze_misc(self.misc)["outside32_matches_original"])
    def test_misc_runtime_bc_change_allowed(self):
        x=bytearray(self.misc);x[2048+12]=0x9f
        struct.pack_into("<I",x,2048+28,zlib.crc32(x[2048:2048+28]))
        self.assertTrue(c.analyze_misc(x)["bc_crc_valid"])
    def test_misc_outside_change_retains_actual_evidence(self):
        x=bytearray(self.misc);x[2080]^=1
        with self.assertRaises(c.EvidenceFailure) as cm:c.analyze_misc(x)
        self.assertIn("prefix_sha256",cm.exception.data)
        self.assertEqual(cm.exception.data["sha256"],c.sha(x))
    def test_misc_bad_crc_and_short_reject(self):
        x=bytearray(self.misc);x[2079]^=1
        with self.assertRaises(c.EvidenceFailure):c.analyze_misc(x)
        with self.assertRaises(c.EvidenceFailure):c.analyze_misc(self.misc[:-1])
    def test_boot_actual_final_local_file(self):
        p=WORK/"evidence/stage2-execution-20261013/final-install-bundle/boot.img"
        self.assertTrue(c.boot_observation(p)["outside_diagnostic_matches_final_boot"])
    def test_boot_diagnostic_only_allowed(self):
        with mock.patch.object(c,"blob_sha",side_effect=[c.CONTRACT["boot_prefix_56m_sha256"],"a"*64,c.CONTRACT["boot_suffix_from60m_sha256"]]) as h:
            self.assertTrue(c.boot_observation("fake")["outside_diagnostic_matches_final_boot"])
        self.assertEqual(h.call_args_list,[mock.call("fake",0,56<<20),mock.call("fake",56<<20,4<<20),mock.call("fake",60<<20,4<<20)])
    def test_boot_outside_change_retained(self):
        with mock.patch.object(c,"blob_sha",side_effect=["a"*64,"b"*64,c.CONTRACT["boot_suffix_from60m_sha256"]]):
            with self.assertRaises(c.EvidenceFailure) as cm:c.boot_observation("fake")
        self.assertEqual(cm.exception.data["prefix_0_to_56m"],"a"*64)
    def test_prepare_and_reboot_commands_rejected(self):
        with mock.patch.object(c.subprocess,"run") as proc:
            for command in (["reboot"],["/opt/e5/t551m-nv-prepare"],["/bin/bash","/opt/e5/e5-next-boot","linux"],["/bin/busybox","dmesg","-c"]):
                with self.assertRaises(c.EvidenceFailure):c.run_command(command)
        proc.assert_not_called()
    def test_command_nonzero_output_retained_and_python_no_cache(self):
        completed=type("Result",(),{"returncode":1,"stdout":b"checks partially passed","stderr":b"NV failure"})()
        with mock.patch.object(c.subprocess,"run",return_value=completed) as proc:
            got=c.run_command(["/usr/bin/python3","-B","/opt/e5/t551m-nv-verify"])
        self.assertEqual(got["exit_code"],1);self.assertEqual(got["stderr"],"NV failure")
        self.assertEqual(proc.call_args.kwargs["env"]["PYTHONDONTWRITEBYTECODE"],"1")
    def test_mac_platform_guard_no_collection(self):
        with mock.patch.object(c.sys,"platform","darwin"),mock.patch.object(c,"blob_sha") as read,contextlib.redirect_stdout(io.StringIO()) as out:
            self.assertEqual(c.main(),2)
        read.assert_not_called();self.assertFalse(json.loads(out.getvalue())["ok"])
    def test_no_file_write_network_or_rw_ioctl_source(self):
        tree=ast.parse((HERE/"collect.py").read_text())
        forbidden={"write_bytes","write_text","unlink","remove","rename","replace","mkdir","rmdir","chmod","chown","symlink_to","connect","socket","mount"}
        for node in ast.walk(tree):
            if not isinstance(node,ast.Call) or not isinstance(node.func,ast.Attribute):continue
            self.assertNotIn(node.func.attr,forbidden)
            if node.func.attr=="open":self.assertEqual(ast.literal_eval(node.args[0]),"rb")
            if node.func.attr=="ioctl":self.assertIn(ast.literal_eval(node.args[1]),(0x80081272,0x125e))
    def test_runtime_script_hashes_match_actual_extracted_files(self):
        root=WORK/"materials/openwrt-build-20261013-569f13d4/runtime-audit/rootfs-ext4-files"
        for p,h in c.CONTRACT["runtime_scripts"].items():self.assertEqual(c.sha((root/p.lstrip('/')).read_bytes()),h)
    def test_shell_wrapper_exact_python_payload(self):
        sh=(HERE/"collect.sh").read_text()
        payload=sh.split("<<'E5_READONLY_PYTHON_20261013'\n",1)[1].rsplit("\nE5_READONLY_PYTHON_20261013\n",1)[0]
        self.assertEqual(payload,(HERE/"collect.py").read_text())


if __name__=="__main__":
    def deny(event,args):
        if event.startswith(("subprocess.","os.system","os.exec","os.posix_spawn","pty.spawn","socket.connect")):
            raise AssertionError("OFFLINE ONLY: "+event)
    sys.addaudithook(deny)
    unittest.main(verbosity=2)
