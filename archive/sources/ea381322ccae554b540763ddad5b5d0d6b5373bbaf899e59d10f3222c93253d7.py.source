import sys

def forbid(event, args):
    if event.startswith('socket.') or event in ('subprocess.Popen', 'os.system', 'os.posix_spawn', 'os.exec'):
        raise RuntimeError('test forbids external operations')
sys.addaudithook(forbid)
import unittest
import stat
from dataclasses import replace
from fd_object_model import Object, Unknown, Busy, compare_complete_pair, SOCKFS, PIPEFS

PIPE = Object(3, 11, 100, stat.S_IFIFO | 0o600, 'pipe:[100]', PIPEFS)
SOCK = Object(4, 12, 200, stat.S_IFSOCK | 0o777, 'socket:[200]', SOCKFS)
REG = Object(5, 13, 300, stat.S_IFREG | 0o600, '/unrelated/file', 0xf2f52010)
ANON = Object(6, 14, 400, stat.S_IFREG | 0o600, 'anon_inode:[eventpoll]', 0x09041934)

class ContractTests(unittest.TestCase):
    def test_identical_strict_set_passes(self):
        self.assertEqual(compare_complete_pair([REG], [REG])['observed_objects_checked'], 2)
    def test_pipe_replacement_between_complete_snapshots(self):
        changed = replace(PIPE, ino=101, link='pipe:[101]')
        result = compare_complete_pair([REG, PIPE], [REG, changed])
        self.assertFalse(result['device_execution_allowed'])
    def test_socket_add_remove_between_complete_snapshots(self):
        compare_complete_pair([REG, SOCK], [REG, replace(SOCK, fd=9, ino=201, link='socket:[201]')])
    def test_named_fifo_on_real_filesystem_is_not_exempt(self):
        fifo = replace(PIPE, fs_magic=0xf2f52010, link='/tmp/fifo')
        with self.assertRaises(Unknown): compare_complete_pair([fifo], [replace(fifo, ino=101)])
    def test_socket_text_and_type_without_sockfs_not_exempt(self):
        fake = replace(SOCK, fs_magic=0xf2f52010)
        with self.assertRaises(Unknown): compare_complete_pair([fake], [replace(fake, ino=201)])
    def test_socket_magic_without_socket_mode_not_exempt(self):
        fake = replace(SOCK, mode=stat.S_IFREG | 0o600)
        with self.assertRaises(Unknown): compare_complete_pair([fake], [replace(fake, ino=201)])
    def test_anon_inode_not_exempt(self):
        with self.assertRaises(Unknown): compare_complete_pair([ANON], [replace(ANON, ino=401)])
    def test_memfd_not_exempt(self):
        memfd = replace(REG, link='/memfd:buffer (deleted)', fs_magic=0x01021994)
        with self.assertRaises(Unknown): compare_complete_pair([memfd], [replace(memfd, ino=301)])
    def test_stream_to_unrelated_file_is_unknown(self):
        with self.assertRaises(Unknown): compare_complete_pair([PIPE], [replace(REG, fd=3)])
    def test_file_to_stream_is_unknown(self):
        with self.assertRaises(Unknown): compare_complete_pair([replace(REG, fd=3)], [PIPE])
    def test_stream_reused_to_protected_is_busy(self):
        with self.assertRaises(Busy): compare_complete_pair([PIPE], [replace(REG, fd=3, link='/data/e5linux/openwrt.ext4')])
    def test_alias_inode_is_busy_even_if_pipe_label(self):
        with self.assertRaises(Busy): compare_complete_pair([PIPE], [PIPE], frozenset({(11, 100)}))
    def test_old_positive_occupancy_is_sticky(self):
        with self.assertRaises(Busy): compare_complete_pair([], [], already_busy=True)
    def test_unpinned_or_unverified_is_unknown(self):
        for item in [replace(PIPE, pinned_path=False), replace(PIPE, identity_verified=False)]:
            with self.subTest(item=item):
                with self.assertRaises(Unknown): compare_complete_pair([item], [item])
    def test_unresolved_enoent_is_not_empty_success(self):
        with self.assertRaises(Unknown): compare_complete_pair([], [], before_complete=False)
    def test_duplicate_fd_is_unknown(self):
        with self.assertRaises(Unknown): compare_complete_pair([PIPE, PIPE], [PIPE])
    def test_old_comparator_rejects_fully_observed_irrelevant_change(self):
        changed = replace(PIPE, ino=101, link='pipe:[101]')
        self.assertNotEqual(PIPE.strict_key(), changed.strict_key())
        compare_complete_pair([PIPE], [changed])

if __name__ == '__main__': unittest.main(verbosity=2)
