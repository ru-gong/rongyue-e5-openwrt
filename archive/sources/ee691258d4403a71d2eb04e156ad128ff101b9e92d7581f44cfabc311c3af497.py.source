 def pin(self,p):return {'bytes':p.stat().st_size,'sha256':c.sha(p.read_bytes())}
 def save(self,rel,val):
  p=self.root/rel;p.parent.mkdir(parents=True,exist_ok=True);p.write_bytes(val if isinstance(val,bytes) else c.encoded(val))
 def reindex(self):
  self.case['files']={str(p.relative_to(self.root)):self.pin(p) for base in (self.execution,self.deployment) for p in base.rglob('*') if p.is_file()};self.case['completed_baseline']={p.name:self.pin(p) for p in (self.state/'completed').iterdir()}
 def request(self,folder,label,opid,mutation,payload,out,rc=0,part=None):
  script='printf synthetic-'+folder;argv=['/fixed/adb','-s','TEST123','shell','-T','/debug_ramdisk/su -c '+shlex.quote(script)]
  b={'schema':'e5-bounded-transport-v1','status':'IN_FLIGHT','serial':'TEST123','txid':self.case['txid'],'boot_id':self.case['boot_id'],'op_id':opid,'label':label,'mutating':mutation,'payload_bytes':payload,'payload_sha256':c.sha(b'x'*payload),'reconciliation_only':False,'recovery_context':None,'automatic_retry':False,'deadline_seconds':8.0,'argv':argv,'argv_sha256':c.sha(c.canonical(argv)),'output_limit':16384}
  if part is not None:b['part_index']=part
  self.save(folder+'/IN_FLIGHT.json',b);self.save(folder+'/stdout.bin',out);self.save(folder+'/stderr.bin',b'')
  self.save(folder+'/transport-result.json',{'returncode':rc,'failure':None,'host_child_reaped':True,'elapsed_seconds':.01,'stdin_bytes_sent':payload,'stdout_bytes':len(out),'stdout_sha256':c.sha(out),'stderr_bytes':0})
  return b,{'folder':folder,'script_sha256':c.sha(script.encode()),**{k:b[k] for k in ('op_id','label','argv_sha256','mutating','payload_bytes','payload_sha256')}}
 def grow(self,event):
  p=self.root/'ledger.jsonl';rows=[json.loads(x) for x in p.read_bytes().splitlines()];r={'seq':len(rows),'previous':rows[-1]['chain_sha256'],'event':event,'txid':'b'*16};r['chain_sha256']=c.sha(c.canonical(r));p.write_bytes(p.read_bytes()+c.encoded(r))
 def snapshot(self,v):return {'serial':'TEST123','markers':{**c.barrier_bindings(v),c.TRANSITION:'ABSENT','ACTIVE.json':'ABSENT','UNCERTAIN.json':'ABSENT','RECOVERY_ONLY.json':'ABSENT'},'ledger_head':v['current_ledger_head'],'ledger_last_event':v['current_ledger_last_event'],'previous_boots':[],'used_txids':[]}

class Tests(unittest.TestCase):
 def setUp(self):self.f=Fixture();self.addCleanup(self.f.tmp.cleanup);self.e=self.f.e
 def test_successful177_then_readonly65(self):self.assertEqual(self.e.verify()['device_mutations_dispatched'],6)
 def test_disabled_before_lock(self):
  self.e.fixture=False
  with self.assertRaisesRegex(c.Refusal,'disabled'):self.e.close()
  self.assertFalse((self.f.root/'GLOBAL.lock').exists())
 def test_fixture_realroot_refused(self):
  with self.assertRaises(c.Refusal):c._Case(c.ROOT,self.f.case,'0'*64,fixture=True)
 def test_close_preserves_all_bytes_and_old_barrier(self):
  files={p:p.read_bytes() for p in self.f.execution.rglob('*') if p.is_file()};old=(self.f.state/'RECOVERY_PENDING.json').read_bytes();ledger=self.e.ledger.read_bytes();markers={n:(self.f.state/n).read_bytes() for n in c.MARKERS}
  v=self.e.close();self.assertTrue(v['deployment_completed']);self.assertEqual((self.f.state/'RECOVERY_PENDING.json').read_bytes(),old);self.assertEqual(self.e.ledger.read_bytes(),ledger)
  for p,raw in files.items():self.assertEqual(p.read_bytes(),raw)
  for n,raw in markers.items():self.assertEqual((self.e.archive/n).read_bytes(),raw);self.assertFalse((self.f.state/n).exists())
  receipt=json.loads((self.e.archive/c.RECEIPT).read_bytes());self.assertEqual(receipt['device_mutations_dispatched'],6);self.assertTrue(receipt['deployment_postwrite_partition_verification_completed']);self.assertEqual(receipt['probe']['device_mutations'],0);self.assertFalse(receipt['post_failure_device_verification_executed']);self.assertFalse((self.e.archive/'COMPLETE.json').exists())
 def test_repeat_close_refused_explicit_resume_same_case(self):
  first=self.e.close()
  with self.assertRaisesRegex(c.Refusal,'duplicate close'):self.e.close()
  self.assertEqual(first,self.e.close(resume=True))
 def test_raw_drift(self):
  (self.f.execution/'transport'/Path(self.f.case['operations'][0]['folder']).name/'stdout.bin').write_bytes(b'drift')
  with self.assertRaises(c.Refusal):self.e.verify()
 def test_prior_pending_drift(self):
  (self.f.state/'RECOVERY_PENDING.json').write_bytes(b'foreign')
  with self.assertRaises(c.Refusal):self.e.verify()
 def test_failed_scan_cannot_be_complete(self):
  p=self.f.root/self.f.case['operations'][-1]['folder'];self.f.save(str(p.relative_to(self.f.root))+'/COMPLETE.json',{})
  with self.assertRaises(c.Refusal):self.e.verify()
 def test_new_operation_refused(self):
  (self.f.execution/'transport/000090-extra').mkdir()
  with self.assertRaises(c.Refusal):self.e.verify()
 def test_missing_followup(self):
  p=self.f.root/self.f.case['deployment_operations'][75]['parts'][0]['folder']/'PART_VERIFIED.json';p.unlink()
  with self.assertRaises((c.Refusal,FileNotFoundError)):self.e.verify()
 def test_mutation_counter_cannot_zero(self):
  self.f.case['mutations']=[]
  with self.assertRaises(c.Refusal):self.e.verify()
 def test_active_wrong(self):
  (self.f.state/'ACTIVE.json').write_text('{}')
  with self.assertRaises(c.Refusal):self.e.verify()
 def test_ledger_growth_before_close_refused(self):
  self.f.grow('START')
  with self.assertRaises(c.Refusal):self.e.close()
 def test_future_ledger_chain_and_new_unknown(self):
  self.e.close();self.f.grow('START');v=self.e.closed()
  with patch.object(c,'validate_closed',return_value=v):
   with self.assertRaises(c.Refusal):c.normal_gate(self.f.state,self.e.ledger)
  for event in ('WRITE','COMPLETE'):self.f.grow(event)
  v=self.e.closed()
  with patch.object(c,'validate_closed',return_value=v):c.normal_gate(self.f.state,self.e.ledger)
  (self.f.state/'UNCERTAIN.json').write_text('{}')
  with patch.object(c,'validate_closed',return_value=v):
   with self.assertRaises(c.Refusal):c.normal_gate(self.f.state,self.e.ledger)
  with self.assertRaises(c.Refusal):self.e.close()
 def test_future_repair_transition_blocks(self):
  v=self.e.close();(self.f.state/c.TRANSITION).write_text('{}')
  with patch.object(c,'validate_closed',return_value=v):
   with self.assertRaises(c.Refusal):c.transport_gate(self.f.state,self.e.ledger,'TEST123','00000000-0000-4000-8000-000000000001','b'*16)
 def test_both_retired_pairs_rejected(self):
  v=self.e.close()
  for boot in v['excluded_boot_ids']:
   with self.assertRaises(c.Refusal):c.assert_new_identity(v,boot,'b'*16)
  for tx in v['retired_txids']:
   with self.assertRaises(c.Refusal):c.assert_new_identity(v,'00000000-0000-4000-8000-000000000001',tx)
 def test_new_identity_and_snapshot(self):
  v=self.e.close();c.assert_new_identity(v,'00000000-0000-4000-8000-000000000001','b'*16)
  with patch.object(c,'validate_closed',return_value=v):
   s=c.augment_snapshot(self.f.snapshot(v),self.f.state,self.e.ledger);c.snapshot_gate(s,self.f.state,self.e.ledger,normal=True)
   self.assertEqual(set(s['previous_boots']),set(v['excluded_boot_ids']));self.assertEqual(set(s['used_txids']),set(v['retired_txids']))
 def test_snapshot_must_keep_old_pending(self):
  v=self.e.close();s=self.f.snapshot(v);s['markers']['RECOVERY_PENDING.json']='ABSENT'
  with patch.object(c,'validate_closed',return_value=v):
   with self.assertRaises(c.Refusal):c.augment_snapshot(s,self.f.state,self.e.ledger)
 def test_interruption_matrix(self):
  for point in ('verified','barrier_durable','prefix_durable','before_ACTIVE.json','after_ACTIVE.json','before_UNCERTAIN.json','after_UNCERTAIN.json','before_receipt','receipt_durable','final_verified'):
   with self.subTest(point=point):
    f=Fixture()
    try:
     def fail(p):
      if p==point:raise c.Refusal('fault')
     f.e.fault=fail
     with self.assertRaises(c.Refusal):f.e.close()
     self.assertTrue(any(c.exists(f.state/n) for n in ('ACTIVE.json','UNCERTAIN.json',c.PENDING)))
     if point not in ('receipt_durable','final_verified'):
      with self.assertRaises((c.Refusal,FileNotFoundError)):f.e.closed()
     f.e.fault=None;f.e.close(resume=point!='verified');f.e.closed()
    finally:f.tmp.cleanup()
 def test_fsync_retry_all_three_levels(self):
  for location in ('state','archive','parent'):
   with self.subTest(location=location):
    f=Fixture();original=c.sync;hit=[]
    try:
     def bad(p):
      target={'state':f.state,'archive':f.e.archive,'parent':f.e.archive.parent}[location]
      if Path(p)==target and not hit:hit.append(True);raise OSError('fsync failed')
      return original(p)
     with patch.object(c,'sync',side_effect=bad):
      with self.assertRaises(OSError):f.e.close()
     synced=[]
     def good(p):synced.append(Path(p));return original(p)
     with patch.object(c,'sync',side_effect=good):f.e.close(resume=(f.state/c.PENDING).exists() or (f.state/(c.PENDING+'.preparing')).exists() or f.e.archive.exists())
     for p in (f.state,f.e.archive,f.e.archive.parent):self.assertIn(p,synced)
    finally:f.tmp.cleanup()
 def test_partial_preparing_preserves_markers(self):
  (self.f.state/(c.PENDING+'.preparing')).write_bytes(b'{')
  with self.assertRaises(c.Refusal):self.e.close()
  self.assertTrue((self.f.state/'ACTIVE.json').exists())
 def test_foreign_barrier_no_overwrite(self):
  (self.f.state/c.PENDING).write_text('foreign')
  with self.assertRaises(c.Refusal):self.e.close()
  self.assertEqual((self.f.state/c.PENDING).read_text(),'foreign')
 def test_noreplace_existing_dest(self):
  a=self.f.root/'a';b=self.f.root/'b';a.write_bytes(b'a');b.write_bytes(b'b')
  with self.assertRaises(OSError):c.noreplace(a,b)
  self.assertEqual((a.read_bytes(),b.read_bytes()),(b'a',b'b'))
 def test_missing_receipt_blocked(self):
  c.durable(self.f.state/c.PENDING,c.encoded(self.e.barrier()))
  with self.assertRaises((c.Refusal,FileNotFoundError)):self.e.closed()
 def test_symlink_marker(self):
  p=self.f.state/'ACTIVE.json';p.unlink();p.symlink_to(self.f.state/'UNCERTAIN.json')
  with self.assertRaises(c.Refusal):self.e.close()
 def test_duplicate_marker(self):
  self.e.archive.mkdir(parents=True);(self.e.archive/'ACTIVE.json').write_bytes((self.f.state/'ACTIVE.json').read_bytes())
  with self.assertRaises(c.Refusal):self.e.close()
 def test_future_completed_prevents_reclose(self):
  self.e.close();(self.f.state/'completed/new.json').write_text('{}')
  with self.assertRaises(c.Refusal):self.e.close()
class PostdeploymentTests(Tests):
 # Only new methods are collected; inherited cases remain in Tests.
 def test_success_result_required_not_relabelled_partial(self):
  p=self.f.deployment/'result/COMPLETE.json';p.unlink();self.f.reindex()
  with self.assertRaises(FileNotFoundError):self.e.verify()
 def test_success_result_link_mismatch(self):
  p=self.f.deployment/'result/COMPLETE.json';d=c.obj(p);d['result']['path']=str(self.f.execution/'RESULT.json');p.write_bytes(c.encoded(d));self.f.case['deployment_complete']['sha256']=c.sha(p.read_bytes());self.f.reindex()
  with self.assertRaises(c.Refusal):self.e.verify()
 def test_success_scanner_raw_disconnected(self):
  p=self.f.deployment/'result/RESULT.json';d=c.obj(p);d['scanner']['errno']=1;p.write_bytes(c.encoded(d));self.f.reindex()
  with self.assertRaises(c.Refusal):self.e.verify()
 def test_probe_cannot_gain_mutation_even_with_matching_begin(self):
  op=self.f.case['operations'][0];op['mutating']=True;p=self.f.root/op['folder'];b=c.obj(p/'IN_FLIGHT.json');b['mutating']=True;self.f.save(op['folder']+'/IN_FLIGHT.json',b)
  done=c.obj(p/'COMPLETE.json');done['mutating']=True;self.f.save(op['folder']+'/COMPLETE.json',done);self.f.save('state/completed/'+op['op_id']+'.json',done);self.f.reindex()
  with self.assertRaisesRegex(c.Refusal,'entirely read-only'):self.e.verify()
 def test_artifact_payload_pin_not_only_operation_summary(self):
  self.f.case['source_artifacts']['scanner']['sha256']='0'*64
  with self.assertRaisesRegex(c.Refusal,'fixed source artifact'):self.e.verify()
 def test_failure_contract_not_prior_stop_reason(self):
  p=self.f.root/self.f.case['operations'][-1]['folder'];rows=[json.loads(x) for x in (p/'stdout.bin').read_bytes().splitlines()];rows[-1]['reason']='final-pid-starttime-changed-unknown';raw=b''.join(c.encoded(r) for r in rows);(p/'stdout.bin').write_bytes(raw)
  result=c.obj(p/'transport-result.json');result.update(stdout_sha256=c.sha(raw),stdout_bytes=len(raw));(p/'transport-result.json').write_bytes(c.encoded(result));self.f.case['failed_scanner_result']=rows[-1]
  review=c.obj(self.f.execution/'REVIEW.json');review['probe']['failed_result']=rows[-1];self.f.save('probe/REVIEW.json',review);self.f.case['review']['sha256']=c.sha(c.encoded(review));self.f.reindex()
  with self.assertRaisesRegex(c.Refusal,'fixed read-only FD-table'):self.e.verify()
 def test_all_three_old_barriers_remain_fixed(self):
  for n in ('RECOVERY_PENDING.json','RECOVERY_TRANSITION.json','RECOVERY_REPAIR_TRANSITION.json'):
   with self.subTest(name=n):
    p=self.f.state/n;raw=p.read_bytes();p.write_bytes(b'foreign')
    try:
     with self.assertRaises(c.Refusal):self.e.verify()
    finally:p.write_bytes(raw)
 def test_history_lifecycle_delegates_without_rewriting_snapshot(self):
  old={'readonly_abort_closure':{'schema':'e5-lifecycle-stop-closure-view-v1'},'markers':{c.PENDING:'ABSENT',c.TRANSITION:'ABSENT'}};copy_before=copy.deepcopy(old);calls=[]
  api=type('Prior',(),{'snapshot_gate':staticmethod(lambda *a,**k:calls.append((a,k)) or {'historical':True})})
  with patch.object(c,'prior_api',return_value=api):self.assertEqual(c.snapshot_gate(old,self.f.state,self.e.ledger),{'historical':True})
  self.assertEqual(old,copy_before);self.assertEqual(len(calls),1)
  old['markers'][c.PENDING]={'foreign':True}
  with patch.object(c,'prior_api',return_value=api):
   with self.assertRaises(c.Refusal):c.snapshot_gate(old,self.f.state,self.e.ledger)
 def test_prefix_tampering_after_closure(self):
  self.e.close();p=self.e.ledger;raw=p.read_bytes();p.write_bytes(raw.replace(b'COMPLETE',b'UNKNOWN!'))
  with self.assertRaises(c.Refusal):self.e.closed()
 def test_normal_gate_all_fresh_unknowns_remain_blocked(self):
  v=self.e.close()
  for name in ('ACTIVE.json','UNCERTAIN.json','RECOVERY_ONLY.json',c.TRANSITION):
   with self.subTest(name=name):
    p=self.f.state/name;p.write_text('{}')
    try:
     with patch.object(c,'validate_closed',return_value=v):
      with self.assertRaises(c.Refusal):c.normal_gate(self.f.state,self.e.ledger)
    finally:p.unlink()
# Do not re-run inherited Tests twice.
for _name in list(Tests.__dict__):
 if _name.startswith('test_') and _name not in PostdeploymentTests.__dict__:setattr(PostdeploymentTests,_name,None)
if __name__=='__main__':unittest.main(verbosity=2)
