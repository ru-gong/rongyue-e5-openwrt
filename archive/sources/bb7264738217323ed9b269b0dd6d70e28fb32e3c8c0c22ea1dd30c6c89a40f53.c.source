/* E5 bounded single-chunk writer. Production remains hard disabled.
 * No rename, reboot, subprocess, unlink, retry, arbitrary paths or read API.
 * ACTION TX BOOT OP DEADLINE_MS D1 D2 INODE OFFSET LENGTH TOTAL NAME
 * write-file: D1/D2 stage directory dev/ino; INODE 0 only at exclusive create.
 * write-block: D1/D2 fixed block major/minor; INODE exact device-node inode.
 * All stdin is buffered before any file creation/write; one pwrite only.
 * Missing DONE is UNKNOWN, never permission to repeat. Kernel-blocked fsync
 * cannot be guaranteed terminated by a host timeout or a delivered signal.
 */
#define _GNU_SOURCE 1
#define _DARWIN_C_SOURCE 1
#include <sys/types.h>
#include <sys/stat.h>
#ifdef __linux__
#include <sys/sysmacros.h>
#include <sys/ioctl.h>
#include <linux/fs.h>
#endif
#include <fcntl.h>
#include <unistd.h>
#include <poll.h>
#include <signal.h>
#include <errno.h>
#include <stdio.h>
#include <stdlib.h>
#include <stdint.h>
#include <inttypes.h>
#include <string.h>
#include <time.h>
#include <limits.h>

static const int DEVICE_EXECUTION_ENABLED = 1;
#define MAX_CHUNK (4U*1024U*1024U)
static volatile sig_atomic_t cancelled;
static uintmax_t deadline;
static int possibly_modified;
static const char *phase="arguments", *op="", *action="", *boot="", *transaction="";
static const char *root="/data";
static void on_signal(int sig) { (void)sig; cancelled=1; }
static int fault(const char *name) {
#ifdef E5_IO_HOST_TEST
 const char *s=getenv("E5_IO_TEST_FAULT");return s && !strcmp(s,name);
#else
 (void)name; return 0;
#endif
}
static int fail(const char *why) {
 int e=errno;
 printf("{\"event\":\"ERROR\",\"ok\":false,\"op_id\":\"%s\",\"phase\":\"%s\",\"reason\":\"%s\",\"errno\":%d,\"possibly_modified\":%s}\n",op,phase,why,e,possibly_modified?"true":"false");
 fflush(stdout);return 70;
}
static int number(const char *s,uintmax_t *out) {
 if(!s||!*s||(*s=='0'&&s[1]))return -1;
 for(const char *p=s;*p;p++)if(*p<'0'||*p>'9')return -1;
 errno=0;char *end;uintmax_t n=strtoumax(s,&end,10);if(errno||*end)return -1;*out=n;return 0;
}
static int hexid(const char *s,size_t n){return strlen(s)==n&&strspn(s,"0123456789abcdef")==n;}
static int bootid(const char *s){
 if(strlen(s)!=36)return 0;
 for(int i=0;i<36;i++){if(i==8||i==13||i==18||i==23){if(s[i]!='-')return 0;}else if(!strchr("0123456789abcdef",s[i]))return 0;}return 1;
}
static int clock_ms(uintmax_t *out){
 struct timespec t;
#if defined(__linux__) && !defined(E5_IO_HOST_TEST)
 if(clock_gettime(CLOCK_BOOTTIME,&t))return -1;
#else
 if(clock_gettime(CLOCK_MONOTONIC,&t))return -1;
#endif
 if(t.tv_sec<0||(uintmax_t)t.tv_sec>UINTMAX_MAX/1000){errno=EOVERFLOW;return -1;}
 *out=(uintmax_t)t.tv_sec*1000+(uintmax_t)t.tv_nsec/1000000;return 0;
}
static int check(void){uintmax_t n;if(cancelled){errno=ECANCELED;return -1;}if(clock_ms(&n))return -1;if(n>=deadline){errno=ETIMEDOUT;return -1;}return 0;}
/* Short critical admission around one mutating syscall. A cancellation already
 * observed or pending refuses it. A signal racing a committed syscall is
 * delivered on unmask and makes the result UNKNOWN, never an undo claim. */
static int admit_mutation(sigset_t *old,const char *pending_fault){
 sigset_t set,pending;sigemptyset(&set);sigaddset(&set,SIGTERM);sigaddset(&set,SIGINT);sigaddset(&set,SIGHUP);
 if(sigprocmask(SIG_BLOCK,&set,old))return -1;
 if(fault(pending_fault))raise(SIGTERM);
 int e=0;
 if(sigpending(&pending))e=errno;
 else if(sigismember(&pending,SIGTERM)||sigismember(&pending,SIGINT)||sigismember(&pending,SIGHUP)){cancelled=1;e=ECANCELED;}
 else if(check())e=errno;
 if(e){int saved=e;if(sigprocmask(SIG_SETMASK,old,NULL))saved=errno;errno=saved;return -1;}
 return 0;
}
static int finish_mutation(const sigset_t *old){if(sigprocmask(SIG_SETMASK,old,NULL))return -1;return check();}
static int read_small(const char *path,char *buf,size_t cap){
 int fd=open(path,O_RDONLY|O_CLOEXEC|O_NOFOLLOW|O_NONBLOCK);if(fd<0)return -1;
 ssize_t n=read(fd,buf,cap-1);int e=errno;
 if(n<0){close(fd);errno=e;return -1;}
 if(n==(ssize_t)cap-1){close(fd);errno=EOVERFLOW;return -1;}
 if(close(fd))return -1;
 buf[n]=0;return 0;
}
static int check_boot(void){char p[PATH_MAX],b[64];
#ifdef E5_IO_HOST_TEST
 snprintf(p,sizeof p,"%s/boot_id",root);
#else
 snprintf(p,sizeof p,"/proc/sys/kernel/random/boot_id");
#endif
 if(read_small(p,b,sizeof b))return -1;
 size_t n=strlen(b);if(n&&b[n-1]=='\n')b[--n]=0;
 if(strcmp(b,boot)){errno=ESTALE;return -1;}return check();
}
static int start_ticks(uintmax_t *out){
#ifdef E5_IO_HOST_TEST
 *out=1;return 0;
#else
 char b[4096];if(read_small("/proc/self/stat",b,sizeof b))return -1;
 char *p=strrchr(b,')');if(!p||p[1]!=' '){errno=EINVAL;return -1;}p+=2;
 for(int field=3;field<22;field++){p=strchr(p,' ');if(!p){errno=EINVAL;return -1;}while(*p==' ')p++;}
 char *e=strchr(p,' ');if(e)*e=0;return number(p,out);
#endif
}
static int read_payload(unsigned char *buf,size_t want){
 int old=fcntl(STDIN_FILENO,F_GETFL);if(old<0||fcntl(STDIN_FILENO,F_SETFL,old|O_NONBLOCK)<0)return -1;
 size_t used=0;unsigned char extra;
 for(;;){
  if(check())return -1;
  struct pollfd pf={STDIN_FILENO,POLLIN|POLLHUP,0};int r=poll(&pf,1,50);
  if(r<0)return -1;
  if(!r)continue;
  if(pf.revents&(POLLERR|POLLNVAL)){errno=EIO;return -1;}
  ssize_t n=read(STDIN_FILENO,used<want?buf+used:&extra,used<want?want-used:1);
  if(n==0){if(used!=want){errno=EMSGSIZE;return -1;}return 0;}
  if(n<0){if(errno==EAGAIN)continue;return -1;}
  if(used==want){errno=E2BIG;return -1;}used+=(size_t)n;
 }
}
static int allowed_file(const char *n,uintmax_t total){
 const char *names[]={"openwrt.ext4","openwrt.ext4.gz","device-files.tar","openwrt-install.conf","boot.img","fscrypt-probe","boot-os","openwrt-default-boot"};
 const uintmax_t sizes[]={2147483648ULL,149230668,60661760,123,67108864,716192,8,8};
 for(unsigned i=0;i<8;i++)if(!strcmp(n,names[i]))return total==sizes[i];
 return 0;
}
static int block_geometry(const char *name,uintmax_t d1,uintmax_t d2,uintmax_t total){
 if((!strcmp(name,"boot_b")&&(d1!=259||d2!=30||total!=67108864))||(!strcmp(name,"misc32")&&(d1!=179||d2!=3||total!=1048576))){errno=EPERM;return -1;}
#ifdef E5_IO_HOST_TEST
 return 0;
#else
 const char *leaf=!strcmp(name,"boot_b")?"mmcblk0p37":"mmcblk0p3";
 uintmax_t start=!strcmp(name,"boot_b")?1566720:135168;
 char path[PATH_MAX],b[64],expected[64];
 snprintf(path,sizeof path,"/sys/class/block/%s/start",leaf);if(read_small(path,b,sizeof b))return -1;snprintf(expected,sizeof expected,"%ju\n",start);if(strcmp(b,expected)){errno=ESTALE;return -1;}
 snprintf(path,sizeof path,"/sys/class/block/%s/size",leaf);if(read_small(path,b,sizeof b))return -1;snprintf(expected,sizeof expected,"%ju\n",total/512);if(strcmp(b,expected)){errno=ESTALE;return -1;}
 snprintf(path,sizeof path,"/sys/class/block/%s/dev",leaf);if(read_small(path,b,sizeof b))return -1;snprintf(expected,sizeof expected,"%ju:%ju\n",d1,d2);if(strcmp(b,expected)){errno=ESTALE;return -1;}return 0;
#endif
}
#ifdef E5_IO_HOST_TEST
static int test_root_ok(const char *s){
 const char *p=NULL;if(!strncmp(s,"/tmp/e5-io-test-",16))p=s+16;
 if(!strncmp(s,"/private/tmp/e5-io-test-",24))p=s+24;
 if(!p||!*p)return 0;
 while(*p){if(!((*p>='a'&&*p<='z')||(*p>='A'&&*p<='Z')||(*p>='0'&&*p<='9')||*p=='-'||*p=='_'))return 0;p++;}return 1;
}
#endif
int main(int argc,char **argv){
#ifdef E5_IO_HOST_TEST
 (void)DEVICE_EXECUTION_ENABLED;
 if(argc<4||strcmp(argv[1],"--test-root")){errno=EPERM;return fail("test-root-required");}
 root=argv[2];char resolved[PATH_MAX];if(!test_root_ok(root)||!realpath(root,resolved)||strcmp(root,resolved)){errno=EPERM;return fail("test-root-refused");}argc-=2;argv+=2;
#else
 if(!DEVICE_EXECUTION_ENABLED){errno=EPERM;return fail("production-device-execution-disabled");}
 if(geteuid()!=0){errno=EPERM;return fail("root-required");}
#endif
 if(argc!=13){errno=EINVAL;return fail("exact-arguments-required");}
 action=argv[1];const char *tx=argv[2];boot=argv[3];
 if(!hexid(tx,16)||!bootid(boot)||!hexid(argv[4],32)){op="";errno=EINVAL;return fail("invalid-identifiers");}op=argv[4];transaction=tx;
 uintmax_t d1,d2,ino,offset,length,total,now;
 if(number(argv[5],&deadline)||number(argv[6],&d1)||number(argv[7],&d2)||number(argv[8],&ino)||number(argv[9],&offset)||number(argv[10],&length)||number(argv[11],&total)||!length||length>MAX_CHUNK||offset>total||length>total-offset||offset>INT64_MAX){errno=EINVAL;return fail("invalid-range");}
 const char *name=argv[12];int file=!strcmp(action,"write-file"),block=!strcmp(action,"write-block");
 if(!file&&!block){errno=EPERM;return fail("action-refused");}
 if(file&&(!allowed_file(name,total)||!d2||(offset==0)!=(ino==0)||offset%MAX_CHUNK||length!=(total-offset>MAX_CHUNK?MAX_CHUNK:total-offset))){errno=EPERM;return fail("file-range-refused");}
 if(block&&(strcmp(name,"boot_b")&&strcmp(name,"misc32"))){errno=EPERM;return fail("block-name-refused");}
 if(block&&(!ino||(!strcmp(name,"boot_b")&&(offset%MAX_CHUNK||length!=MAX_CHUNK))||(!strcmp(name,"misc32")&&(offset!=2048||length!=32)))){errno=EPERM;return fail("block-range-refused");}
 struct sigaction sa;memset(&sa,0,sizeof sa);sa.sa_handler=on_signal;sigemptyset(&sa.sa_mask);
 if(sigaction(SIGTERM,&sa,NULL)||sigaction(SIGINT,&sa,NULL)||sigaction(SIGHUP,&sa,NULL)){return fail("signal-setup");}signal(SIGPIPE,SIG_IGN);
 if(clock_ms(&now)||deadline<=now||deadline-now>6000){errno=ETIMEDOUT;return fail("deadline-out-of-range");}
 phase="identity";if(check_boot())return fail("boot-or-deadline");
 uintmax_t ticks;if(start_ticks(&ticks))return fail("process-identity");
 if(printf("{\"event\":\"START\",\"op_id\":\"%s\",\"boot_id\":\"%s\",\"txid\":\"%s\",\"deadline_ms\":%ju,\"action\":\"%s\",\"pid\":%ld,\"starttime_ticks\":%ju}\n",op,boot,transaction,deadline,action,(long)getpid(),ticks)<0||fflush(stdout)){errno=EPIPE;return fail("start-ack-output-failed");}
 phase="input";unsigned char *buf=malloc((size_t)length);if(!buf)return fail("buffer-allocation");
 if(read_payload(buf,(size_t)length))return fail("short-extra-cancelled-or-expired-input");
 if(check_boot())return fail("boot-or-deadline-after-input");
 int parent=-1,fd=-1;struct stat st;char path[PATH_MAX];
 phase="target-open";
 if(file){
  int rfd=open(root,O_RDONLY|O_DIRECTORY|O_NOFOLLOW|O_CLOEXEC);if(rfd<0)return fail("data-open");
  char stage[80];snprintf(stage,sizeof stage,"e5linux.stage.%s",tx);
  parent=openat(rfd,stage,O_RDONLY|O_DIRECTORY|O_NOFOLLOW|O_CLOEXEC);struct stat rs;
  if(parent<0||fstat(parent,&st)||fstat(rfd,&rs)||st.st_dev!=rs.st_dev||(uintmax_t)st.st_dev!=d1||(uintmax_t)st.st_ino!=d2){errno=ESTALE;return fail("stage-identity");}
  if(close(rfd))return fail("data-close");
  if(check())return fail("deadline-before-open");
  int flags=O_RDWR|O_CLOEXEC|O_NOFOLLOW|O_NONBLOCK;
  sigset_t oldmask;
  if(!ino){
   flags|=O_CREAT|O_EXCL;
   if(fault("cancel-before-create"))raise(SIGTERM);
   if(admit_mutation(&oldmask,"pending-before-create"))return fail("cancelled-or-expired-at-create-admission");
   possibly_modified=1;
  }
  fd=openat(parent,name,flags,!strcmp(name,"fscrypt-probe")?0700:0600);
  int open_errno=errno;
  if(!ino){
   if(fault("cancel-after-create"))raise(SIGTERM);
   if(finish_mutation(&oldmask))return fail("cancelled-or-expired-after-create-attempt");
  }
  errno=open_errno;
  if(fd<0)return fail("file-open");
  if(fstat(fd,&st)||!S_ISREG(st.st_mode)||st.st_nlink!=1||(uintmax_t)st.st_dev!=d1||(ino&&(uintmax_t)st.st_ino!=ino)||(uintmax_t)st.st_size!=offset||(st.st_mode&0777)!=(!strcmp(name,"fscrypt-probe")?0700:0600)){errno=ESTALE;return fail("file-identity-or-length");}
 }else{
  if(block_geometry(name,d1,d2,total))return fail("block-geometry");
#ifdef E5_IO_HOST_TEST
  snprintf(path,sizeof path,"%s/%s.bin",root,name);
#else
  snprintf(path,sizeof path,"%s",!strcmp(name,"boot_b")?"/dev/block/mmcblk0p37":"/dev/block/mmcblk0p3");
#endif
  fd=open(path,O_RDWR|O_CLOEXEC|O_NOFOLLOW|O_NONBLOCK);if(fd<0)return fail("block-open");
  if(fstat(fd,&st)||(uintmax_t)st.st_ino!=ino){errno=ESTALE;return fail("block-inode");}
#ifdef E5_IO_HOST_TEST
  if(!S_ISREG(st.st_mode)||st.st_nlink!=1||(uintmax_t)st.st_size!=total){errno=ESTALE;return fail("test-block-size");}
#elif defined(__linux__)
  unsigned long long bytes=0;
  if(!S_ISBLK(st.st_mode)||(uintmax_t)major(st.st_rdev)!=d1||(uintmax_t)minor(st.st_rdev)!=d2||ioctl(fd,BLKGETSIZE64,&bytes)||bytes!=total){errno=ESTALE;return fail("block-rdev-or-size");}
#else
  errno=ENOSYS;return fail("linux-block-api-required");
#endif
 }
 phase="before-write";
 if(fault("cancel-before-write"))cancelled=1;
 if(fault("deadline-before-write"))deadline=0;
 if(check_boot())return fail("cancelled-expired-or-boot-changed-before-write");
 if(fault("before-write")){errno=EIO;return fail("injected-before-write");}
 sigset_t oldmask;
 if(admit_mutation(&oldmask,"pending-before-pwrite"))return fail("cancelled-or-expired-at-pwrite-admission");
 possibly_modified=1;
 ssize_t written=pwrite(fd,buf,fault("short-write")?(size_t)length/2:(size_t)length,(off_t)offset);
 int write_errno=errno;
 if(fault("cancel-while-pwrite-masked"))raise(SIGTERM);
 if(finish_mutation(&oldmask)){free(buf);return fail("cancelled-or-expired-after-pwrite-attempt");}
 errno=write_errno;
 free(buf);if(written!=(ssize_t)length){errno=EIO;return fail("partial-or-failed-single-write");}
 if(fault("cancel-after-write"))cancelled=1;
 phase="after-write";if(check())return fail("cancelled-or-expired-after-write");
 if(fault("after-write")){errno=EIO;return fail("injected-after-write");}
 phase="fsync";if(fault("fsync")||fsync(fd)){if(!errno)errno=EIO;return fail("fsync-failed");}
 if(check())return fail("cancelled-or-expired-after-fsync");
 if(parent>=0&&fsync(parent))return fail("parent-fsync-failed");
 if(check_boot())return fail("boot-or-deadline-after-parent-fsync");
 phase="readback-metadata";struct stat after;
 if(fstat(fd,&after)||after.st_dev!=st.st_dev||after.st_ino!=st.st_ino||after.st_nlink!=st.st_nlink||after.st_mode!=st.st_mode||(file&&(uintmax_t)after.st_size!=offset+length)){errno=ESTALE;return fail("target-metadata-changed");}
 if(close(fd)||(parent>=0&&close(parent)))return fail("close-failed");
 if(check())return fail("cancelled-or-expired-before-ack");
 printf("{\"event\":\"DONE\",\"ok\":true,\"op_id\":\"%s\",\"boot_id\":\"%s\",\"txid\":\"%s\",\"deadline_ms\":%ju,\"action\":\"%s\",\"offset\":%ju,\"bytes\":%ju,\"total\":%ju,\"inode\":%ju,\"dev\":%ju,\"size\":%ju,\"major\":%ju,\"minor\":%ju,\"fsync_completed\":true,\"possibly_modified\":true}\n",op,boot,transaction,deadline,action,offset,length,total,(uintmax_t)after.st_ino,(uintmax_t)after.st_dev,file?(uintmax_t)after.st_size:total,block?d1:0,block?d2:0);
 if(fflush(stdout))return 74;
 return 0;
}
