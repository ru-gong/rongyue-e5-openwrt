s=s[:start]+'''    def _request(self,op,*,part=None,completed=True):
        p=self.path(op['folder']);b=obj(p/'IN_FLIGHT.json');r=obj(p/'transport-result.json')
        need((b['serial'],b['txid'],b['boot_id'],b['op_id'],b['label']) ==
             (self.c['serial'],self.c['txid'],self.c['boot_id'],op['op_id'],op['label']),'request identity')
        need(b['automatic_retry'] is False and b['reconciliation_only'] is False and b['recovery_context'] is None and
             b['deadline_seconds']==8.0,'fixed normal bounded transport')
        argv=b['argv'];need(len(argv)==6 and argv[1:5]==['-s',self.c['serial'],'shell','-T'],'fixed shell transport')
        quoted=shlex.split(argv[-1]);need(len(quoted)==3 and quoted[:2]==['/debug_ramdisk/su','-c'],'fixed su quoting')
        need(sha(canonical(argv))==b['argv_sha256']==op['argv_sha256'] and
             sha(quoted[2].encode())==op['script_sha256'],'exact audited script')
        need(all(b[k]==op[k] for k in ('mutating','payload_bytes','payload_sha256')),'scope/payload differs')
        raw=read(p/'stdout.bin');err=read(p/'stderr.bin')
        need(not err and r['stderr_bytes']==0 and r['failure'] is None and r['host_child_reaped'] is True and
             r['stdin_bytes_sent']==b['payload_bytes'] and r['stdout_bytes']==len(raw) and
             r['stdout_sha256']==sha(raw) and len(raw)<=b['output_limit'] and 0<=r['elapsed_seconds']<=8,'transport incomplete')
        need(r['returncode']==(0 if completed else 70),'return code differs')
        if part is not None:
            need(b['part_index']==part and b['mutating'] is False and b['payload_bytes']==0 and b['payload_sha256']==sha(b''),'followup scope')
            need(obj(p/'PART_VERIFIED.json')=={'op_id':b['op_id'],'part_index':part,'validated':True},'followup unverified')
        elif completed:
            done=obj(p/'COMPLETE.json')
            need(done['status']=='COMPLETE' and done['validated'] is True and done['stdout_sha256']==sha(raw) and
                 all(done.get(k)==v for k,v in b.items() if k!='status'),'completion differs')
            need(read(p/'COMPLETE.json')==read(self.state/'completed'/(b['op_id']+'.json')),'shared completion differs')
        else:
            need(not exists(p/'COMPLETE.json') and not exists(self.state/'completed'/(b['op_id']+'.json')),'failed scan must remain incomplete')
            u=obj(p/'UNCERTAIN.json');need(u['reason']==self.c['expected_error'] and u['remote_completion_proven'] is False,'failure semantics')
            need(read(p/'IN_FLIGHT.json')==read(self.locate_marker('ACTIVE.json')) and
                 read(p/'UNCERTAIN.json')==read(self.locate_marker('UNCERTAIN.json')),'failed markers differ')
            rows=[json.loads(line) for line in raw.splitlines()];last=rows[-1]
            need(last['schema']=='e5-native-occupancy-v1' and last['event']=='RESULT' and last['complete'] is False and
                 last['txid']==self.c['txid'] and last['boot_id']==self.c['boot_id'] and last['opid']==b['op_id'] and
                 last['errno']==7 and last['fds']==131073 and last['subphase']=='pid-fds' and last['detail']=='fd-link-check' and
                 last['cancel_signal']==0 and last['unknown']==['scan-not-complete'],'fixed E2BIG failure only')
        return b
    def verify(self):
        c=self.c;self.prior()
        need(c['schema']=='e5-fixed-partial-deployment-case-v1' and len(c['operations'])==83,'fixed partial case')
        need(obj(self.state/'STATE_BINDING.json')=={'schema':'e5-transport-state-v1','serial':c['serial']},'state identity')
        for rel,pin in c['files'].items():read(self.path(rel),pin)
        completed=directory(self.state/'completed')
        need({p.name for p in completed.iterdir()}==set(c['completed_baseline']),'new completed activity before closure')
        for name,pin in c['completed_baseline'].items():
            need(Path(name).name==name,'completed basename');read(completed/name,pin)
        actual={str(p.relative_to(self.root)) for p in self.execution.rglob('*') if p.is_file() or p.is_symlink()}
        need(actual=={p for p in c['files'] if p.startswith(c['execution']+'/')},'execution evidence set changed')
        folders=sorted(p.name for p in (self.execution/'transport').iterdir() if p.is_dir())
        need(folders==[Path(x['folder']).name for x in c['operations']],'operation set/order')
        review=obj(self.path(c['review']['path']))
        need(sha(read(self.path(c['review']['path'])))==c['review']['sha256'] and
             review['status']=='STOP_PARTIAL_DEPLOYMENT_NOT_READY' and review['actual_mutation_count']==6 and
             review['completed_top_level_operations']==82 and review['completed_followups']==14 and
             review['postwrite_protected_baseline_executed'] is False and
             review['no_partition_or_rootfs_write_command_dispatched'] is True,'fixed independent review')
        mutations=[];part_count=0
        for i,op in enumerate(c['operations']):
            need(op['completed']==(i<82),'fixed completed order')
            b=self._request(op,completed=i<82)
            if b['mutating']:mutations.append((b['label'],b['op_id'],b['payload_bytes'],b['payload_sha256']))
            parts=sorted(p.name for p in self.path(op['folder']).glob('part-*'))
            need(parts==[Path(x['folder']).name for x in op['parts']],'followup set changed')
            for j,sub in enumerate(op['parts'],1):
                need(sub['op_id']==op['op_id'],'followup parent');self._request(sub,part=j);part_count+=1
        need(part_count==14 and mutations==[(m['label'],m['op_id'],m['payload_bytes'],m['payload_sha256']) for m in c['mutations']],'six exact acknowledged mutations')
        need([m[0] for m in mutations]==['stage2-upload-archiver','stage2-archive-old-lock','stage2-new-lock','stage2-upload-scanner','stage2-upload-io_helper','stage2-upload-helper'],'mutation allowlist')
        need(not exists(self.execution/'result/RESULT.json') and not exists(self.execution/'result/COMPLETE.json'),'never deployment complete')
        need(not exists(self.state/'RECOVERY_ONLY.json') and not exists(self.state/TRANSITION),'new recovery activity')
        if exists(self.state/PENDING):need(read(self.state/PENDING)==encoded(self.barrier()),'foreign partial barrier')
        self.ledger_check(True)
        return {'status':'VERIFIED_PARTIAL_DEPLOYMENT_STOP_NOT_READY','case_sha256':self.case_sha,'operation_count':83,'device_mutations_dispatched':6}
