s=s.replace("need(view['retired_txid'] in snapshot['used_txids'] and view['excluded_boot_id'] in snapshot['previous_boots'],","need(set(view['retired_txids'])<=set(snapshot['used_txids']) and set(view['excluded_boot_ids'])<=set(snapshot['previous_boots']),")
s=s.replace("snapshot=dict(snapshot,readonly_abort_closure=view)","need(snapshot['markers'].get('RECOVERY_PENDING.json')==view['prior_closure']['barrier'],'prior snapshot barrier binding')\n    snapshot=dict(snapshot,readonly_abort_closure=view)")
