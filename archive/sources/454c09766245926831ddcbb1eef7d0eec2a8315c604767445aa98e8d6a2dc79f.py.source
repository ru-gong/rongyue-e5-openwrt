"""Exact retained-proof unit regressions. All rows are synthetic, host only."""
import sys,copy,hashlib,importlib.util,json,unittest,ast
from pathlib import Path
def audit(event,args):
 if event.startswith(('subprocess.','socket.')) or event in ('os.system','os.posix_spawn','os.fork'):raise AssertionError(event)
sys.addaudithook(audit)
H=Path(__file__).resolve().parent
sp=importlib.util.spec_from_file_location('retained_phase',H/'overlay/core/phase_evidence.py');p=importlib.util.module_from_spec(sp);sp.loader.exec_module(p)

class Tests(unittest.TestCase):
 def setUp(self):
  self.case=json.loads((H/'CASE.json').read_bytes());self.known=self.case['retained_device_state'];self.before={}
  for old,new in (('old_lock','new_lock'),('old_owner','new_owner')):
   self.before[old]={k:(int(v,16) if isinstance(v,str) and k in ('mode_bits','rdev_major','rdev_minor') else int(v) if k in ('dev','inode','bytes','uid','gid','nlink') else v) for k,v in self.known['current_lock'][new].items()}
  group=[];records={}
  for item in self.case['retained_read_items']:
   raw=('\n'.join(item['expected_lines'])+'\n').encode();label=item['label']
   records[label]={'path':item['path'],'stdout_sha256':p.sha(raw)}
   group.append({'begin':{'label':label,'mutating':False,'payload_bytes':0,'payload_sha256':p.sha(b'')},'raw':raw})
  self.rows=group+[{'begin':{'label':'stage2-upload-archiver','mutating':True},'raw':b''},{'begin':{'label':'occupancy','mutating':False},'raw':b''}]+copy.deepcopy(group)
  self.result={'partial_deployment_preserved':records};q=H/'CASE.json';self.manifest={'closure_case':{'path':str(q),'sha256':p.sha(q.read_bytes()),'bytes':q.stat().st_size}}
 def call(self):return p.partial_retained_proof(self.rows,self.result,self.before,self.manifest)
 def test_both_exact_groups_accepted(self):self.assertEqual(self.call(),self.result['partial_deployment_preserved'])
 def test_missing_post_read_rejected(self):
  self.rows.pop()
  with self.assertRaises(p.Refusal):self.call()
 def test_extra_duplicate_rejected(self):
  self.rows.append(copy.deepcopy(self.rows[-1]))
  with self.assertRaises(p.Refusal):self.call()
 def test_misordered_group_rejected(self):
  self.rows[0],self.rows[1]=self.rows[1],self.rows[0]
  with self.assertRaises(p.Refusal):self.call()
 def test_prewrites_not_bracketed(self):
  self.rows.insert(0,self.rows.pop(18))
  with self.assertRaises(p.Refusal):self.call()
 def test_postscan_not_bracketed(self):
  self.rows.append(self.rows.pop(19))
  with self.assertRaises(p.Refusal):self.call()
 def test_program_sha_tamper_rejected(self):
  self.rows[-1]['raw']=self.rows[-1]['raw']+b'drift'
  with self.assertRaises(p.Refusal):self.call()
 def test_old_archive_owner_changed_rejected(self):
  self.rows[1]['raw']=self.rows[1]['raw'].replace(b'fad8a60f84aa4268',b'0000000000000000')
  with self.assertRaises(p.Refusal):self.call()
 def test_current_lock_inode_changed_rejected(self):
  self.before['old_lock']['inode']+=1
  with self.assertRaises(p.Refusal):self.call()
 def test_summary_cannot_disconnect_raw(self):
  self.result['partial_deployment_preserved']={}
  with self.assertRaises(p.Refusal):self.call()
 def test_mutating_retained_rejected(self):
  self.rows[1]['begin']['mutating']=True
  with self.assertRaises(p.Refusal):self.call()
 def test_payload_retained_rejected(self):
  self.rows[-1]['begin']['payload_bytes']=1
  with self.assertRaises(p.Refusal):self.call()
 def test_case_binding_not_generic(self):
  self.manifest['closure_case']['sha256']='f'*64
  with self.assertRaises(p.Refusal):self.call()
 def test_phase_keeps_all_prior_functions_except_deployment(self):
  old=ast.parse((H.parents[1]/'tools/e5_nextphase_core_live_441f60bc8933be12/phase_evidence.py').read_text());new=ast.parse((H/'overlay/core/phase_evidence.py').read_text())
  funcs=lambda t:{n.name:ast.dump(n,include_attributes=False) for n in t.body if isinstance(n,ast.FunctionDef)}
  a,b=funcs(old),funcs(new)
  for name in set(a)-{'partial_retained_proof'}:self.assertEqual(a[name],b[name],name)
  deployment=next(n for n in new.body if isinstance(n,ast.FunctionDef) and n.name=='deployment')
  calls=[n for n in ast.walk(deployment) if isinstance(n,ast.Call) and isinstance(n.func,ast.Name) and n.func.id=='partial_retained_proof'];self.assertEqual(len(calls),1)
if __name__=='__main__':unittest.main(verbosity=2)
