#!/usr/bin/env python3
"""Actual host filesystem tests; never invoke ADB/USB/VM or target binaries.

Both test and disabled production binaries are compiled from the same C source.
All mutated paths are exclusively created /tmp/e5-directory-test-*/data sandboxes.
Test compilation does not enable the production /data code path.
"""
import hashlib
import json
import os
from pathlib import Path
import shutil
import socket
import signal
import subprocess
import sys
import tempfile
import time
import unittest

SOURCE=Path(__file__).with_name('device_directory_helper.c').resolve()
CC=shutil.which('cc')
ALLOWED_BINARIES=set()

def sentinel(event,args):
    if event.startswith('socket.') or event in ('os.system','os.posix_spawn','os.posix_spawnp','os.exec'):
        raise AssertionError('network/indirect process forbidden')
    if event=='subprocess.Popen':
        executable=Path(args[0]).resolve()
        if executable not in ALLOWED_BINARIES:
            raise AssertionError('unapproved host process '+str(executable))
sys.addaudithook(sentinel)

class HelperTests(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        if not CC: raise RuntimeError('host C compiler missing')
        cls.build=tempfile.TemporaryDirectory(prefix='e5-directory-build-',dir='/tmp')
        cls.bin=Path(cls.build.name).resolve()/'helper-test'
        cls.disabled=Path(cls.build.name).resolve()/'helper-production-disabled'
        ALLOWED_BINARIES.add(Path(CC).resolve())
        for binary,flags in ((cls.bin,['-DE5_DIRECTORY_HOST_TEST=1']),(cls.disabled,[])):
            subprocess.run([CC,'-std=c11','-Wall','-Wextra','-Werror','-O2',*flags,str(SOURCE),'-o',str(binary)],check=True,capture_output=True)
            ALLOWED_BINARIES.add(binary.resolve())
        cls.source_hash=hashlib.sha256(SOURCE.read_bytes()).hexdigest()
    @classmethod
    def tearDownClass(cls):
        assert hashlib.sha256(SOURCE.read_bytes()).hexdigest()==cls.source_hash
        cls.build.cleanup()
    def setUp(self):
        self.tmp=tempfile.TemporaryDirectory(prefix='e5-directory-test-',dir='/tmp')
        self.root=Path(self.tmp.name).resolve()/'data';self.root.mkdir()
        self.tx='0123456789abcdef'
        self.boot='00000000-0000-4000-8000-000000000001'
        self.op='a'*32
        (self.root.parent/'boot_id').write_text(self.boot+'\n')
        self.paths={'active':self.root/'e5linux',**{r:self.root/f'e5linux.{r}.{self.tx}' for r in ('stage','archive','failed')}}
        self.newdir('active',b'old-rootfs');self.newdir('stage',b'new-rootfs')
    def tearDown(self):self.tmp.cleanup()
    def newdir(self,role,payload):
        p=self.paths[role];p.mkdir();(p/'openwrt.ext4').write_bytes(payload)
        return p
    def invoke(self,action,role=None,fault=None,source_role=None,overrides=None,deadline=None,omit_deadline=False):
        source_role=source_role or {'move-active-to-archive':'active','move-stage-to-active':'stage','move-active-to-failed':'active','move-archive-to-active':'archive'}.get(action,role or 'active')
        ds=self.root.stat(); ss=self.paths[source_role].stat()
        a=[action,self.tx,self.boot,self.op,str(deadline if deadline is not None else int(time.clock_gettime(getattr(time,"CLOCK_BOOTTIME",time.CLOCK_MONOTONIC))*1000)+6000),str(ds.st_dev),str(ds.st_ino),str(ss.st_dev),str(ss.st_ino),role or source_role]
        if overrides:
            for i,v in overrides.items():a[i if i<2 else i+3]=v
        if omit_deadline:a.pop(4)
        env=dict(os.environ);env.pop('E5_DIRECTORY_TEST_FAULT',None)
        if fault:env['E5_DIRECTORY_TEST_FAULT']=fault
        result=subprocess.run([str(self.bin),'--test-root',str(self.root),*a],env=env,capture_output=True,text=True,timeout=8)
        self.assertEqual(result.stderr,'')
        return result.returncode,json.loads(result.stdout.splitlines()[-1])
    def success(self,*args,**kwargs):
        rc,r=self.invoke(*args,**kwargs);self.assertEqual(rc,0,r);self.assertTrue(r['ok']);return r
    def failure(self,*args,**kwargs):
        rc,r=self.invoke(*args,**kwargs);self.assertNotEqual(rc,0,r);self.assertFalse(r['ok']);return r
    def test_01_seal_and_ordered_switch_rollback(self):
        old=self.paths['active'].stat().st_ino;new=self.paths['stage'].stat().st_ino
        self.success('seal','stage')
        self.success('move-active-to-archive')
        self.assertFalse(self.paths['active'].exists());self.assertEqual(self.paths['archive'].stat().st_ino,old)
        self.success('move-stage-to-active');self.assertEqual(self.paths['active'].stat().st_ino,new)
        self.success('move-active-to-failed');self.success('move-archive-to-active')
        self.assertEqual((self.paths['active']/'openwrt.ext4').read_bytes(),b'old-rootfs')
        self.assertEqual((self.paths['failed']/'openwrt.ext4').read_bytes(),b'new-rootfs')
    def test_02_gap_can_restore_archive_without_activation(self):
        self.success('move-active-to-archive');self.success('move-archive-to-active')
        self.assertEqual((self.paths['active']/'openwrt.ext4').read_bytes(),b'old-rootfs')
        self.assertTrue(self.paths['stage'].is_dir())
    def test_03_existing_destination_never_overwritten(self):
        p=self.newdir('archive',b'existing');ino=p.stat().st_ino
        self.failure('move-active-to-archive');self.assertEqual(p.stat().st_ino,ino)
        self.assertEqual((p/'openwrt.ext4').read_bytes(),b'existing')
    def test_04_wrong_source_inode_no_move(self):
        self.failure('move-active-to-archive',overrides={5:'1'});self.assertTrue(self.paths['active'].is_dir());self.assertFalse(self.paths['archive'].exists())
    def test_05_wrong_root_inode_no_move(self):
        self.failure('move-active-to-archive',overrides={3:'1'});self.assertTrue(self.paths['active'].is_dir())
    def test_06_cross_device_expectation_rejected(self):
        self.failure('move-active-to-archive',overrides={4:str(self.root.stat().st_dev+1)})
    def test_07_file_symlink_rejected_before_rename(self):
        (self.paths['active']/'link').symlink_to('/etc/passwd');self.failure('move-active-to-archive');self.assertFalse(self.paths['archive'].exists())
    def test_08_peer_directory_symlink_rejected(self):
        shutil.rmtree(self.paths['stage']);self.paths['stage'].symlink_to(self.paths['active'],target_is_directory=True)
        self.failure('move-active-to-archive')
    def test_09_hardlink_rejected(self):
        os.link(self.paths['active']/'openwrt.ext4',self.paths['active']/'alias')
        self.failure('move-active-to-archive')
    def test_10_fifo_rejected_without_open_blocking(self):
        os.mkfifo(self.paths['active']/'fifo');self.failure('move-active-to-archive')
    def test_11_unknown_state_rejected(self):
        self.newdir('failed',b'unknown');self.failure('move-active-to-archive')
    def test_12_file_fsync_failure_no_move(self):
        r=self.failure('move-active-to-archive',fault='file-fsync');self.assertFalse(r['renamed']);self.assertTrue(self.paths['active'].exists())
    def test_13_parent_fsync_before_failure_no_move(self):
        r=self.failure('move-active-to-archive',fault='parent-fsync-before');self.assertFalse(r['renamed']);self.assertTrue(self.paths['active'].exists())
    def test_14_rename_failure_no_retry(self):
        r=self.failure('move-active-to-archive',fault='rename');self.assertFalse(r['renamed']);self.assertFalse(self.paths['archive'].exists())
    def test_15_post_rename_fsync_failure_keeps_moved_state(self):
        r=self.failure('move-active-to-archive',fault='parent-fsync-after');self.assertTrue(r['renamed']);self.assertFalse(r['fsync_completed'])
        self.assertFalse(self.paths['active'].exists());self.assertTrue(self.paths['archive'].exists())
        # Caller cannot replay the original action as though nothing happened.
        self.failure('move-active-to-archive',source_role='archive')
    def test_16_nested_directories_are_synced(self):
        p=self.paths['stage']/'nested';p.mkdir();(p/'file').write_bytes(b'inner')
        r=self.success('seal','stage');self.assertEqual(r['files_fsynced'],2);self.assertEqual(r['directories_fsynced'],2)
    def test_17_depth_bound(self):
        p=self.paths['stage']
        for i in range(10):p=p/str(i);p.mkdir()
        self.failure('seal','stage')
    def test_18_invalid_transaction_and_numeric_inputs(self):
        for i,value in ((1,'../escape'),(1,'0123456789abcdeF'),(2,'-1'),(3,'0x1'),(3,'01'),(5,'18446744073709551616')):
            with self.subTest(i=i,value=value):self.failure('move-active-to-archive',overrides={i:value})
    def test_19_production_refuses_before_path_access(self):
        for args in ([],['seal',self.tx,'1','1','1','1','stage'],['--test-root',str(self.root)]):
            r=subprocess.run([str(self.disabled),*args],env={**os.environ,'DEVICE_EXECUTION_ENABLED':'1'},capture_output=True,text=True,timeout=8)
            self.assertNotEqual(r.returncode,0);self.assertEqual(json.loads(r.stdout.splitlines()[-1])['reason'],'production-device-execution-disabled')
    def test_20_test_binary_refuses_real_data(self):
        r=subprocess.run([str(self.bin),'--test-root','/data','seal'],capture_output=True,text=True,timeout=8)
        self.assertNotEqual(r.returncode,0);self.assertEqual(json.loads(r.stdout.splitlines()[-1])['reason'],'host-test-root-refused')
    def test_21_entry_bound(self):
        for i in range(257):(self.paths['stage']/f'f{i}').touch()
        self.failure('seal','stage')
    def test_22_directory_fsync_failure_no_move(self):
        r=self.failure('move-active-to-archive',fault='directory-fsync');self.assertFalse(r['renamed'])
    def test_23_move_wrong_order_refused(self):
        self.failure('move-stage-to-active');self.failure('move-active-to-failed')
    def test_24_source_fsync_after_failure_keeps_moved_state(self):
        r=self.failure('move-active-to-archive',fault='source-fsync-after');self.assertTrue(r['renamed']);self.assertTrue(self.paths['archive'].exists())

    def test_25_no_replace_unsupported_never_falls_back(self):
        r=self.failure('move-active-to-archive',fault='rename-unsupported')
        self.assertFalse(r['renamed']);self.assertFalse(self.paths['archive'].exists())
        self.assertTrue(self.paths['active'].is_dir())
    def test_26_unknown_action_no_move(self):
        self.failure('other-action');self.assertTrue(self.paths['active'].is_dir())

    def test_27_move_requires_explicit_deadline(self):
        r=self.failure('move-active-to-archive',omit_deadline=True)
        self.assertFalse(r['renamed']);self.assertTrue(self.paths['active'].is_dir())
    def test_28_expired_deadline_before_flush_refuses_move(self):
        r=self.failure('move-active-to-archive',deadline=1)
        self.assertEqual(r['phase'],'deadline-before-seal');self.assertFalse(r['renamed'])
    def test_29_expiry_during_fsync_refuses_actual_rename(self):
        r=self.failure('move-active-to-archive',fault='deadline-after-fsync')
        self.assertEqual(r['phase'],'rename-no-replace');self.assertFalse(r['renamed'])
        self.assertTrue(self.paths['active'].is_dir());self.assertFalse(self.paths['archive'].exists())
    def test_30_invalid_deadline_refused(self):
        for value in ('0','-1','NaN','18446744073709551616'):
            with self.subTest(value=value):self.failure('move-active-to-archive',deadline=value)

    def test_31_seal_also_requires_short_deadline(self):
        self.failure('seal','stage',deadline=1)
        self.failure('seal','stage',deadline=int(time.clock_gettime(getattr(time,"CLOCK_BOOTTIME",time.CLOCK_MONOTONIC))*1000)+20000)
    def test_32_wrong_boot_refused_before_flush(self):
        (self.root.parent/'boot_id').write_text('0'*36)
        r=self.failure('move-active-to-archive')
        self.assertFalse(r['mutation_attempted'])
    def test_33_cancel_during_fsync_no_move(self):
        r=self.failure('move-active-to-archive',fault='cancel-during-fsync')
        self.assertEqual(r['cancel_signal'],signal.SIGTERM)
        self.assertFalse(r['mutation_attempted'])
        self.assertTrue(self.paths['active'].exists());self.assertFalse(self.paths['archive'].exists())
    def test_34_cancel_after_rename_reports_unknown(self):
        r=self.failure('move-active-to-archive',fault='cancel-after-rename')
        self.assertTrue(r['renamed']);self.assertTrue(r['mutation_attempted'])
        self.assertEqual(r['outcome'],'UNKNOWN_AFTER_MUTATION_ATTEMPT')
        self.assertFalse(self.paths['active'].exists());self.assertTrue(self.paths['archive'].exists())
    def test_35_real_signals_during_flush_no_later_rename(self):
        for sig in (signal.SIGTERM,signal.SIGINT,signal.SIGHUP):
            with self.subTest(sig=sig):
                ds=self.root.stat();ss=self.paths['active'].stat()
                deadline=int(time.clock_gettime(getattr(time,"CLOCK_BOOTTIME",time.CLOCK_MONOTONIC))*1000)+2000
                argv=[str(self.bin),'--test-root',str(self.root),'move-active-to-archive',self.tx,self.boot,self.op,str(deadline),str(ds.st_dev),str(ds.st_ino),str(ss.st_dev),str(ss.st_ino),'active']
                env={**os.environ,'E5_DIRECTORY_TEST_FAULT':'pause-during-fsync'}
                p=subprocess.Popen(argv,env=env,stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True)
                rows=[]
                while True:
                    line=p.stdout.readline();self.assertTrue(line)
                    row=json.loads(line);rows.append(row)
                    if row['phase']=='seal-source':break
                p.send_signal(sig)
                out,err=p.communicate(timeout=3)
                rows.extend(json.loads(x) for x in out.splitlines())
                r=rows[-1];self.assertNotEqual(p.returncode,0);self.assertEqual(err,'')
                self.assertEqual(r['cancel_signal'],sig);self.assertFalse(r['mutation_attempted'])
                self.assertTrue(self.paths['active'].exists());self.assertFalse(self.paths['archive'].exists())
    def test_36_actual_deadline_during_flush_no_rename(self):
        deadline=int(time.clock_gettime(getattr(time,"CLOCK_BOOTTIME",time.CLOCK_MONOTONIC))*1000)+50
        r=self.failure('move-active-to-archive',fault='pause-during-fsync',deadline=deadline)
        self.assertFalse(r['mutation_attempted']);self.assertTrue(self.paths['active'].exists())
    def test_37_bindings_and_result_markers(self):
        r=self.success('seal','stage')
        self.assertEqual(r['schema'],'e5-native-directory-v3')
        self.assertEqual((r['txid'],r['boot_id'],r['opid']),(self.tx,self.boot,self.op))
        self.assertEqual(r['outcome'],'COMPLETED');self.assertGreater(r['self_pid'],0)
        self.assertFalse(r['power_loss_safety_proven'])

if __name__=='__main__':unittest.main(verbosity=2)
