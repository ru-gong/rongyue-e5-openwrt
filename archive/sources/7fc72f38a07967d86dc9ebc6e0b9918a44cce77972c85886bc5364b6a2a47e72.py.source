import hashlib
import io
import json
import os
from pathlib import Path
import subprocess
import tarfile
import tempfile
import unittest
from unittest.mock import patch
import android_directory_adapter as a

TX = "0123456789abcdef"
BOOT = "00000000-0000-4000-8000-000000000001"

class AdapterTests(unittest.TestCase):
    def setUp(self):
        self.tmp = tempfile.TemporaryDirectory()
        self.root = Path(self.tmp.name).resolve()
        self.binary = self.root / "dummy"; self.binary.write_bytes(b"never executed")
        self.art = a.Artifact(self.binary, self.binary.stat().st_size, a.sha_file(self.binary))
        self.ad = a.AndroidDirectoryAdapter(self.art, self.art, TX, BOOT)

    def tearDown(self): self.tmp.cleanup()

    def test_all_transport_disabled_before_process(self):
        with patch.object(a.subprocess, "run", side_effect=AssertionError("process forbidden")):
            for call in (lambda: self.ad._shell("anything"), self.ad.acquire,
                         lambda: self.ad.inspect("active"),
                         lambda: self.ad.backup_to_mac("active", {}, self.root / "backup.tar")):
                with self.assertRaisesRegex(a.Refusal, "DEVICE_IO_DISABLED"): call()

    def test_environment_does_not_enable(self):
        with patch.dict(os.environ, {"DEVICE_IO_DISABLED": "0", "E5_LIVE": "1"}):
            with self.assertRaisesRegex(a.Refusal, "DEVICE_IO_DISABLED"): self.ad.acquire()

    def test_invalid_identifiers(self):
        for tx in ("../x", TX + ";id", "A"*16, "" ):
            with self.assertRaises(a.Refusal): a.AndroidDirectoryAdapter(self.art, self.art, tx, BOOT)
        with self.assertRaises(a.Refusal): a.AndroidDirectoryAdapter(self.art, self.art, TX, "$(id)")

    def test_unknown_role_and_move(self):
        with self.assertRaises(a.Refusal): self.ad.path("../../boot_a")
        with self.assertRaises(a.Refusal): self.ad.move("delete", {})

    def test_pin_changed_artifact(self):
        self.binary.write_bytes(b"changed")
        with self.assertRaises(a.Refusal): self.art.verify()

    def test_symlink_and_hardlink_inputs(self):
        linked = self.root / "linked"; linked.symlink_to(self.binary)
        with self.assertRaises(a.Refusal): a.Artifact(linked, self.art.size, self.art.sha256).verify()
        linked.unlink(); os.link(self.binary, linked)
        with self.assertRaises(a.Refusal): self.art.verify()

    def test_parent_symlink_input(self):
        sub = self.root / "sub"; sub.mkdir(); file = sub / "x"; file.write_bytes(b"x")
        link = self.root / "link"; link.symlink_to(sub)
        with self.assertRaises(a.Refusal): a.Artifact(link / "x", 1, a.sha_file(file)).verify()

    def test_guard_syntax_and_scope(self):
        script = self.ad._guard()
        proc = subprocess.run(["/bin/bash", "-n"], input=script.encode(), capture_output=True)
        self.assertEqual(proc.returncode, 0, proc.stderr)
        for required in (BOOT, a.SERIAL, "_a", "pipefail", "backing_file", "/proc/[0-9]*/fd"):
            self.assertIn(required, script)
        self.assertNotIn("dd of=", script)
        self.assertNotIn("reboot", script)

    def test_unsafe_remote_path(self):
        for p in ("/dev/block/mmcblk0p36", "/data/e5linux/../../x", "/data/e5linux/a;id"):
            with self.assertRaises(a.Refusal): self.ad.verify_file(p, 1, "a"*64)

    def test_stage_rejects_unknown_file_without_transport(self):
        with patch.object(self.ad, "_shell", side_effect=AssertionError("transport")):
            with self.assertRaises(a.Refusal): self.ad.stage({"boot_a": self.art}, 2<<30, "a"*64)

    def test_inventory_parser_complete_and_strict(self):
        h = hashlib.sha256(b"x").hexdigest()
        good = f"d - 1 2 4096 700 0 0 .\nf {h} 1 3 1 600 0 0 ./openwrt.ext4\n".encode()
        with patch.object(self.ad, "_shell", return_value=good):
            snap = self.ad.inspect("active")
            self.assertEqual(len(snap["rows"]), 2)
            self.assertEqual(snap["tree_sha256"], a.tree_digest(snap["rows"]))
        for bad in (b"", good+good, good.replace(b" 1 3 ", b" 2 3 "),
                    good.replace(b"./openwrt.ext4", b"./../escape")):
            with patch.object(self.ad, "_shell", return_value=bad):
                with self.assertRaises(a.Refusal): self.ad.inspect("active")

    def make_tar(self, *, missing=False, bad=False, link=False, duplicate=False):
        data = b"x"; h = hashlib.sha256(data).hexdigest()
        rows = [dict(path=".", type="d", mode="700", uid=0, gid=0, bytes=0, sha256="-"),
                dict(path="./openwrt.ext4", type="f", mode="600", uid=0, gid=0, bytes=1, sha256=h)]
        snap = dict(rows=rows, tree_sha256=a.tree_digest(rows))
        p = self.root / "backup.tar"
        with tarfile.open(p, "w") as t:
            m=tarfile.TarInfo("."); m.type=tarfile.DIRTYPE; m.mode=0o700; t.addfile(m)
            if not missing:
                m=tarfile.TarInfo("./openwrt.ext4"); m.mode=0o600; m.size=1
                if link: m.type=tarfile.SYMTYPE; m.linkname="/etc/passwd"; m.size=0
                t.addfile(m, io.BytesIO(b"y" if bad else data) if not link else None)
                if duplicate: t.addfile(m, io.BytesIO(data))
        return p, snap

    def test_complete_backup(self):
        p,snap=self.make_tar()
        self.assertTrue(a.verify_backup_tar(p,snap)["complete"])

    def test_backup_missing(self):
        p,snap=self.make_tar(missing=True)
        with self.assertRaises(a.Refusal): a.verify_backup_tar(p,snap)

    def test_backup_corrupt_content(self):
        p,snap=self.make_tar(bad=True)
        with self.assertRaises(a.Refusal): a.verify_backup_tar(p,snap)

    def test_backup_link(self):
        p,snap=self.make_tar(link=True)
        with self.assertRaises(a.Refusal): a.verify_backup_tar(p,snap)

    def test_backup_duplicate(self):
        p,snap=self.make_tar(duplicate=True)
        with self.assertRaises(a.Refusal): a.verify_backup_tar(p,snap)

    def test_wrong_boot_or_hash_prevents_helper(self):
        snap=dict(txid=TX,boot_id=BOOT,role="active",rows=[],tree_sha256="a"*64)
        with patch.object(self.ad, "inspect", return_value={}), patch.object(self.ad, "_shell", side_effect=AssertionError("transport")):
            with self.assertRaises(a.Refusal): self.ad._helper_call("seal","active",snap)
        snap["boot_id"] = "wrong"
        with self.assertRaises(a.Refusal): self.ad._helper_call("seal","active",snap)

if __name__ == "__main__": unittest.main()
