"""Synthetic capture/tar fixtures only; external execution is denied."""
import copy
import hashlib
import io
import json
import os
from pathlib import Path
import stat
import sys
import tarfile
import tempfile
import unittest
from unittest.mock import patch
import host_archive as a


def deny(event,args):
    if event.startswith(("subprocess.","socket.")) or event in ("os.system","os.exec","os.posix_spawn"):
        raise AssertionError("external operation forbidden: "+event)
sys.addaudithook(deny)


def stat_bytes(kind,size=0,inode=100,mode="600",uid=1000,gid=1001):
    bits={"d":stat.S_IFDIR,"f":stat.S_IFREG,"b":stat.S_IFBLK}[kind]|int(mode,8)
    return f"{bits:x}|1|{inode}|{size}|{mode}|{uid}|{gid}|1|100|101|mtime-ns|ctime-ns|0|0".encode()


def envelope(data,source,offset,requested,rawstat):
    parts=a.BOOT.encode()+b"\t"+source.encode()+b"\t"+str(offset).encode()+b"\t"+str(requested).encode()+b"\t"+rawstat
    return b"META\t"+parts+b"\n"+data+b"\nEND\t"+parts+b"\n"


class ArchiveTests(unittest.TestCase):
    def setUp(self):
        self.tmp=tempfile.TemporaryDirectory();self.root=Path(self.tmp.name).resolve();self.folder=self.root/"capture";self.folder.mkdir()
        self.index=0;self.contents={"./alpha":b"hello\0\xff\n","./empty":b""}
        self.rowstats=[(".",stat_bytes("d",4096,100,"700")),("./alpha",stat_bytes("f",8,101,"640")),
                       ("./empty",stat_bytes("f",0,102,"600")),("./emptydir",stat_bytes("d",4096,103,"750"))]
        self.rows=[{"path":name,**a.parse_stat(s)} for name,s in self.rowstats]
        self.profile={"serial":a.SERIAL,"partitions":{"misc":{"node":"/dev/block/mmcblk0p3","dev":"179:3","start_lba":135168,"bytes":1048576}},
                      "protected_hashes":{},"gpt_prefix_sha256":a.sha(b"gpt")}
        self.plan={"schema":"synthetic-only","block_reads":{"gpt-prefix":["/dev/block/mmcblk0",3]}}
        pp=self.root/"profile.json";pp.write_bytes(a.canonical(self.profile));self.write("plan.json",self.plan)
        self.patches=[patch.object(a,"PROFILE",pp),patch.object(a,"PROFILE_SHA",a.sha(pp.read_bytes())),
                      patch.object(a,"PLAN_SHA",a.sha((self.folder/"plan.json").read_bytes()))]
        for p in self.patches:p.start()
        geometry=b"/dev/block/mmcblk0p3\n179:3\n135168\n2048\n"
        self.add("geometry",geometry);self.add("transport-status-probe",b"E5_STDOUT_PROBE\n",37,b"E5_STDERR_PROBE\n")
        misc=b"m"*4096;ms=stat_bytes("b")
        self.add("read-misc",envelope(misc,"/dev/block/mmcblk0p3",0,4096,ms));self.add("read-misc",envelope(misc,"/dev/block/mmcblk0p3",0,4096,ms))
        self.add("binary-transport-proof",a.sha(misc).encode()+b"  -\n")
        self.write("transport-proof.json",{"bytes":4096,"sha256":a.sha(misc),"double_read_equal":True,"remote_hash_equal":True})
        objects=[self.object("gpt-prefix","/dev/block/mmcblk0",b"gpt","gpt-prefix.bin",stat_bytes("b"))]
        inv=b"BOOT\0"+a.BOOT.encode()+b"\0"+b"".join(n.encode()+b"\0"+s+b"\0" for n,s in self.rowstats)+b"END\0"+a.BOOT.encode()+b"\0"
        self.add("scope-check",b"SCOPE_BEGIN\nSELF_MOUNTS_OK\nINIT_MOUNTS_OK\nGLOBAL_LOOPS_OK\nSCOPE_END\n")
        self.add("inventory-before",inv);self.write("inventory-before.json",self.rows)
        for n,(name,s) in enumerate(self.rowstats):
            if name in self.contents:objects.append(self.object("file",a.DIRECTORY+"/"+name[2:],self.contents[name],f"directory-file-{n:04d}.bin",s))
        self.add("inventory-after",inv);self.write("inventory-after.json",self.rows);self.add("geometry",geometry)
        self.complete={"schema":"e5-readonly-capture-v2","read_consistency":a.READ_CONSISTENCY,"serial":a.SERIAL,"boot_id":a.BOOT,"phase":"directory","full_directory":True,
                       "device_writes":False,"chunk_bytes":4<<20,"requests":self.index,"files":objects}
        self.write("COMPLETE.json",self.complete)

    def test_old_capture_schema_rejected(self):
        self.complete["schema"]="e5-readonly-capture-v1";self.write("COMPLETE.json",self.complete)
        with self.assertRaises(a.Reject):self.build()
        self.assertFalse((self.root/"archive").exists())

    def test_missing_readonly_scope_policy_rejected(self):
        self.complete.pop("read_consistency");self.write("COMPLETE.json",self.complete)
        with self.assertRaises(a.Reject):self.build()
        self.assertFalse((self.root/"archive").exists())

    def test_failed_scope_marker_rejected(self):
        self.mutate_request("scope-check",lambda data:data.replace(b"INIT_MOUNTS_OK",b"INIT_MOUNTS_UNKNOWN"))
        with self.assertRaises(a.Reject):self.build()
        self.assertFalse((self.root/"archive").exists())

    def tearDown(self):
        for p in reversed(self.patches):p.stop()
        self.tmp.cleanup()

    def write(self,name,obj):
        (self.folder/name).write_bytes(a.canonical(obj)+b"\n")

    def add(self,label,raw,rc=0,err=b""):
        self.index+=1;stem=f"{self.index:05d}-{label}";script=b"# synthetic fixture, never executed\n"
        for suffix,data in (("stdout",raw),("stderr",err),("sh.txt",script)):(self.folder/(stem+"."+suffix)).write_bytes(data)
        self.write(stem+".json",{"label":label,"failure":None,"device_write_commands":False,"automatic_retry":False,"deadline":8,
                   "elapsed_seconds":0.01,"stdout_bytes":len(raw),"stderr_bytes":len(err),"stdout_sha256":a.sha(raw),"script_sha256":a.sha(script),
                   "limit":a.MAX_RAW,"returncode":rc})

    def object(self,kind,source,data,destination,rawstat):
        if data:
            self.add("read-"+kind,envelope(data,source,0,len(data),rawstat))
            self.add("verify-"+kind,envelope(a.sha(data).encode()+b"  -\n",source,0,len(data),rawstat))
        (self.folder/destination).write_bytes(data)
        return {"kind":kind,"source":source,"bytes":len(data),"host_file":destination,"sha256":a.sha(data),"stat":a.parse_stat(rawstat),
                "independent_remote_chunk_hashes_verified":True}

    def build(self):return a.build(self.folder,self.root/"archive","0123456789abcdef")

    def mutate_request(self,label,transform):
        p=next(self.folder.glob("?????-"+label+".stdout"));raw=transform(p.read_bytes());p.write_bytes(raw)
        m=json.loads(p.with_suffix(".json").read_text());m.update(stdout_bytes=len(raw),stdout_sha256=a.sha(raw));p.with_suffix(".json").write_bytes(a.canonical(m)+b"\n")

    def test_valid_archive_preserves_empty_directory_metadata_and_session_schema(self):
        result=self.build();out=self.root/"archive";snapshot=json.loads((out/"inventory.json").read_text())
        self.assertFalse(result["device_execution_authorized"]);self.assertEqual(stat.S_IMODE((out/"directory-backup.tar").stat().st_mode),0o600)
        with tarfile.open(out/"directory-backup.tar") as tar:
            members={m.name.rstrip("/"):m for m in tar};self.assertEqual(set(members),{r["path"] for r in self.rows})
            self.assertTrue(members["./emptydir"].isdir());self.assertEqual(members["./alpha"].mode,0o640);self.assertEqual(members["./alpha"].uid,1000)
        receipt=json.loads((out/"directory-backup.tar.verified.json").read_text())
        self.assertEqual(receipt["tree_sha256"],snapshot["tree_sha256"]);self.assertEqual(receipt["role"],"active")
        self.assertTrue(a.verify_tar(out/"directory-backup.tar",snapshot)["complete"])

    def test_source_bytes_unchanged(self):
        before={p.name:p.read_bytes() for p in self.folder.iterdir()};self.build()
        self.assertEqual(before,{p.name:p.read_bytes() for p in self.folder.iterdir()})

    def test_incomplete_stopped_capture_rejected(self):
        self.write("STOP.json",{"reason":"timeout"})
        with self.assertRaises(a.Reject):self.build()
        self.assertFalse((self.root/"archive").exists())

    def test_reassembled_corruption_rejected(self):
        (self.folder/"directory-file-0001.bin").write_bytes(b"badbytes")
        with self.assertRaisesRegex(a.Reject,"reassembled"):self.build()

    def test_wrong_offset_even_self_consistent_record_hash_rejected(self):
        self.mutate_request("read-file",lambda b:b.replace(b"\t0\t8\t",b"\t4096\t8\t"))
        with self.assertRaisesRegex(a.Reject,"range"):self.build()

    def test_remote_hash_disagrees(self):
        self.mutate_request("verify-file",lambda b:b.replace(a.sha(self.contents["./alpha"]).encode(),b"0"*64))
        with self.assertRaisesRegex(a.Reject,"chunk hash"):self.build()

    def test_after_inventory_drift_rejected(self):
        changed=copy.deepcopy(self.rows);changed[1]["inode"]+=1;self.write("inventory-after.json",changed)
        with self.assertRaisesRegex(a.Reject,"inventory drift"):self.build()

    def test_missing_and_duplicate_request_refused(self):
        p=next(self.folder.glob("?????-verify-file.json"));p.unlink()
        with self.assertRaisesRegex(a.Reject,"request count"):self.build()

    def test_symlink_source_and_unsafe_member_refused(self):
        path=self.folder/"directory-file-0001.bin";original=self.root/"original";path.rename(original);path.symlink_to(original)
        with self.assertRaisesRegex(a.Reject,"unsafe host"):self.build()
        for path in ("../x","./a/../x","/absolute","./a//x","./a/./x"):
            with self.assertRaises(a.Reject):a.name_safe(path)

    def test_existing_output_and_output_inside_capture_refused(self):
        (self.root/"archive").mkdir()
        with self.assertRaises(FileExistsError):self.build()
        with self.assertRaisesRegex(a.Reject,"outside source"):a.build(self.folder,self.folder/"archive","0123456789abcdef")

    def test_tar_content_corruption_refused(self):
        self.build();path=self.root/"archive/directory-backup.tar";snapshot=json.loads((self.root/"archive/inventory.json").read_text())
        with tarfile.open(path) as tar:offset=tar.getmember("./alpha").offset_data
        with path.open("r+b") as f:f.seek(offset);f.write(b"X")
        with self.assertRaisesRegex(a.Reject,"tar file bytes"):a.verify_tar(path,snapshot)

    def test_host_mutation_between_validation_and_tar_refused(self):
        rows,files=a.Evidence(self.folder).validate();snapshot=a.session_inventory(rows,files,"0123456789abcdef")
        files["./alpha"]["path"].write_bytes(b"changed!")
        with self.assertRaisesRegex(a.Reject,"source changed"):a.make_tar(self.root/"bad.tar",rows,files,snapshot)


if __name__=="__main__":unittest.main(verbosity=2)
